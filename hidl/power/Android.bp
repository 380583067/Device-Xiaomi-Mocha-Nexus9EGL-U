cc_binary {
    name: "android.hardware.power-service.mocha",
    defaults: ["android.hardware.power-ndk_shared"],
    relative_install_path: "hw",
    init_rc: ["android.hardware.power-service.mocha.rc"],
    // The IPower/default declaration lives in manifest.xml. A separate vintf
    // fragment would declare the same instance twice; libvintf refuses the
    // merge ("Conflicting FqInstance") and then EVERY vendor HAL fails to
    // register at boot - the composer included, which took the whole boot
    // down once already (gk20a_vm_put NULL deref in surfaceflinger).
    srcs: [
        "BoostPulse.cpp",
        "CameraHints.cpp",
        "GpuFloor.cpp",
        "QosFloor.cpp",
        "Power.cpp",
        "Profiles.cpp",
        "ProviderWatch.cpp",
        "service.cpp",
    ],
    local_include_dirs: ["."],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "android.hardware.common-V2-ndk",
        "android.hardware.common.fmq-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
    ],
    proprietary: true,
}
