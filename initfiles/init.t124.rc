on boot

    exec_start init-btloader-sh

	# Power management settings
    # Enable power gating of fast CPU's
    write /sys/module/cpuidle_t11x/parameters/cpu_power_gating_in_idle 31
    write /sys/module/cpuidle_t11x/parameters/slow_cluster_power_gating_noncpu 1
    write /sys/module/cpuidle/parameters/power_down_in_idle 1

    write /sys/module/cpuidle_t11x/parameters/stop_mc_clk_in_idle 1
    write /sys/devices/system/cpu/cpuquiet/current_governor runnable
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp 0
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/enable 0
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/down_delay 500
    write /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/idle_top_freq 204000

    write /sys/module/tegra12_emc/parameters/pasr_enable 1

    # TBD: Remove the below line that give permissions for scaling_governor
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    # The new power HAL's camera hints cap the frequency while the camera runs
    # (CameraHints writes scaling_max_freq), so this node must be system-writable.
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq

    # GPU floor: the kernel does have /sys/kernel/tegra_gpu/gpu_floor_rate (an
    # earlier source grep missed it because the node name is built at run time) and
    # the power HAL's GpuFloor has to write it. This tree forces GPU composition, so
    # SurfaceFlinger keeps reporting EXPENSIVE_RENDERING; with the floor in place the
    # GPU stays at 252 MHz instead of ramping up from 72 MHz. Without the permission
    # the HAL gets EACCES on every attempt and one boot logs 1500+ error lines.
    chown system system /sys/kernel/tegra_gpu/gpu_floor_rate
    chmod 0664 /sys/kernel/tegra_gpu/gpu_floor_rate

    # CPU governor: interactive
    # (the defconfig default is userspace, so without setting it explicitly the
    # frequency never moves.)
    #
    # [2026-11-21 fix] This used to write:
    #     interactive/awake_ideal_freq   1326000
    #     interactive/boost_freq         1428000
    #     interactive/touch_poke_freq    1326000
    #     interactive/input_boost_duration 45000
    # Those four nodes exist **only for smartmax** (smartmax_attributes[] in
    # kernel/drivers/cpufreq/cpufreq_smartmax.c), not in interactive's sysfs (see
    # the gov_sys_pol_attr_rw list in cpufreq_interactive.c). So all four writes
    # failed on every boot and **none of the tuning applied**; interactive ran the
    # kernel defaults:
    #     target_loads 90 / go_hispeed_load 99 / min_sample_time 30ms
    # With go_hispeed_load=99 the frequency only rises above hispeed past 99% load,
    # so scrolling and transitions - 50-70% on one core - stayed pinned at low
    # frequency, which is exactly where the "it stutters" came from.
    # Below it writes the nodes interactive really has, with the values verified in
    # the 19.1 tree's balanced profile.
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor interactive
    write /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq 1428000
    write /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load 90
    write /sys/devices/system/cpu/cpufreq/interactive/target_loads 80
    write /sys/devices/system/cpu/cpufreq/interactive/timer_rate 20000
    write /sys/devices/system/cpu/cpufreq/interactive/timer_slack 40000
    write /sys/devices/system/cpu/cpufreq/interactive/min_sample_time 20000
    write /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay 40000
    write /sys/devices/system/cpu/cpufreq/interactive/io_is_busy 1

    # [2026-11-21 fix] Hand the governor nodes to system so NVIDIA's power HAL
    # (/system/vendor/bin/hw/android.hardware.power@1.0-service, log tag
    # powerHAL::common, already listening on atmel-maxtouch) can scale by scenario.
    # The kernel creates these nodes 0644 root:root and the HAL runs as system, so
    # every boot used to log only:
    #     E powerHAL::common: Error opening .../interactive/hispeed_freq: Permission denied
    #     (target_loads / above_hispeed_delay / timer_rate / boost_factor failed too)
    # so touch boosting and its whole governor profile were dead. Hand them back.
    # Note: init chown/chmod on A14 **does not accept wildcards** (do_chown/do_chmod
    # in system/core/init/builtins.cpp lchown/fchmodat the literal path), list each.
    chown system system /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chown system system /sys/devices/system/cpu/cpufreq/interactive/target_loads
    chown system system /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay
    chown system system /sys/devices/system/cpu/cpufreq/interactive/timer_rate
    chown system system /sys/devices/system/cpu/cpufreq/interactive/timer_slack
    chown system system /sys/devices/system/cpu/cpufreq/interactive/min_sample_time
    chown system system /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chown system system /sys/devices/system/cpu/cpufreq/interactive/boost
    chown system system /sys/devices/system/cpu/cpufreq/interactive/boost_factor
    chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse
    chown system system /sys/devices/system/cpu/cpufreq/interactive/boostpulse_duration
    chown system system /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
    chown system system /sys/devices/system/cpu/cpufreq/interactive/io_busy_threshold
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/hispeed_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/target_loads
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/above_hispeed_delay
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/timer_rate
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/timer_slack
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/min_sample_time
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/go_hispeed_load
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/boost
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/boost_factor
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/boostpulse
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/boostpulse_duration
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/io_is_busy
    chmod 0664 /sys/devices/system/cpu/cpufreq/interactive/io_busy_threshold

    # smartmax is opened up the same way so it can be switched to later for
    # comparison (nodes: smartmax_attributes[] in cpufreq_smartmax.c).
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/awake_ideal_freq
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/boost_freq
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/touch_poke_freq
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/input_boost_duration
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/sampling_rate
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/up_rate
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/down_rate
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/max_cpu_load
    chown system system /sys/devices/system/cpu/cpufreq/smartmax/min_cpu_load

    chown system system /sys/devices/platform/host1x/tegradc.0/enable
    chown system system /sys/devices/platform/host1x/tegradc.1/enable
    chown system system /sys/devices/platform/host1x/nvavp/boost_sclk
    chown system system /sys/class/input/input1/enabled
    chown system system /sys/class/input/input2/enabled
    chown system system /sys/class/input/input3/enabled
    chown system system /sys/class/input/input4/enabled
    chown system system /sys/class/input/input5/enabled
    chown system system /sys/class/input/input6/enabled
    chown system system /sys/class/input/input7/enabled

    write /sys/module/input_cfboost/parameters/boost_freq 1326000
    write /sys/module/input_cfboost/parameters/boost_emc 396000
    write /sys/module/input_cfboost/parameters/boost_gpu 252000
    write /sys/module/input_cfboost/parameters/boost_time 75
    write /sys/module/input_cfboost/parameters/boost_cpus 1

    write /sys/module/workqueue/parameters/power_efficient 1

    # [2026-11-23 CPU tuning] zram compression streams 1 -> 4 (Cortex-A15 quad-core).
    # Note: **sysfs cannot be used here**. max_comp_streams_store only allows
    # decreasing after init_done, so `echo 4 > max_comp_streams` returns EINVAL,
    # reads back 1 and dmesg says "Cannot change max compression streams".
    # The value that matters is the kernel default:
    #   drivers/block/zram/zram_drv.c  zram_add() / zram_reset_device()
    #   zram->max_comp_streams = 4;
    # With one stream, swap-out under memory pressure uses one core while three idle,
    # and the compression latency shows up as dropped frames in foreground video and
    # rendering; four streams compress in parallel (same total CPU, much less jitter).
    # The algorithm is already lz4 (CONFIG_ZRAM_LZ4_COMPRESS=y) with a measured 3.25:1
    # ratio, so 1.5 GB of zram is enough - growing it would only encourage the kernel
    # to swap more and cost CPU.

    # Little VM tweaks
    # swappiness 100: the only swap device is 1GB of zram, so pushing anonymous
    # pages out is cheap and keeps more applications resident. The kernel
    # documentation recommends 100+ when swapping to zram.
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 100
    # min_free_kbytes defaulted to 3000 (3MB) on this 2GB device, which leaves
    # kswapd with almost no headroom: allocations then go through direct reclaim
    # in the allocating thread (the UI thread), which shows up as frame spikes.
    # 8MB costs little and keeps reclaim off the fast path.
    #
    # [2026-11-23 raised to 16 MB] Short-video stress test: while scrolling Kuaishou
    # Lite, MemFree sat at 0-20 MB for long stretches (0 sampled repeatedly). At that
    # point the kernel reclaims libglcore's file-backed JIT pages
    # (/data/data/<pkg>/cache/.glXXXXXX, mmap'ed then unlinked, reclaimable) while the
    # driver still holds the function pointers, so _glDrawArrays jumps to address 0
    # and SIGSEGVs. A higher watermark lets kswapd step in earlier and avoids the
    # direct-reclaim extreme.
    write /proc/sys/vm/min_free_kbytes 16384
    
    # Prepare CPU/EMC scaling based on DT
    chown system system /sys/kernel/tegra_cpu_emc/table_src
    write /sys/kernel/tegra_cpu_emc/table_src 1

on late-fs
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/nr_requests 256
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048
    write /sys/block/mmcblk0/queue/scheduler deadline
    write /sys/block/mmcblk1/queue/scheduler deadline

on property:sys.boot_completed=1
    write /sys/block/mmcblk0/queue/iostats 1
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/rq_affinity 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 128
    write /sys/block/mmcblk1/queue/read_ahead_kb 128
    write /sys/block/mmcblk1/queue/rq_affinity 0

on init
    # Mount a tmpfs into /mnt/tmp for hosting nvram, phs shared memory
    mkdir /mnt/tmp 0770 system system
    mount tmpfs tmpfs /mnt/tmp mode=0775,gid=1003

# Loads real wifi and bt mac from /dev/block/mmcblk0p15
service conn_wifi /system/vendor/bin/conn_init -op
    class main
    user root
    group root
    seclabel u:r:conn_wifi:s0
    oneshot

# [format fix 2026-11-17] Section keywords are flush left and trailing spaces are
# gone. The init parser trims whitespace either way, this is just normalisation so
# `grep '^service '` works. Note: this service is started by `exec_start
# init-btloader-sh` in `on boot`, and exec_start goes through Service::ExecStart(),
# which ignores the disabled flag (builtins.cpp:269).
service init-btloader-sh /system/bin/init.btloader.sh
    class main
    user root
    group root system
    disabled
    oneshot

# The sensors HAL is a passthrough one, so system_server creates its IPC pipe
# directory /data/sns_lsm6db0_pipes after the one-time restorecon pass init
# does over /data. Without this the directory keeps the generic
# system_data_root_file label forever and the pipes are relabelled only on a
# fresh install. Idempotent and cheap; harmless if the HAL did not run.
on property:sys.boot_completed=1
    restorecon_recursive /data/sns_lsm6db0_pipes
    # ussrd creates /data/misc/phs itself, so it is labelled here (post-fs-data
    # is too early, the directory does not exist yet) and is correct from the
    # next boot on.
    restorecon_recursive /data/misc/phs
    # logd reads persist.logd.size when it starts, which is before the persist
    # properties are loaded - so the 4M setting in build.prop never reaches it
    # and every boot silently comes up with the 256 KiB default. Re-apply the
    # size once boot has finished; persist.logd.size stays in build.prop for
    # the next logd start after a manual "stop logd; start logd".
    exec_background - root root -- /system/bin/logcat -G 4M

# Note on why there is no mkdir for /data/sns_lsm6db0_pipes here: the HAL
# removes the directory and recreates it on every start (the boot log shows
# remove_name on that very name), so anything init creates in post-fs-data is
# gone by the time the HAL runs. The restorecon above is what actually keeps
# the label correct, and it runs after the HAL has had its turn.


# [HongGuo crash fix 2026-11-26] tmpfs over the cache directory of GL-heavy
# apps: the NVIDIA GL driver JITs shaders into a cache file it unlinks
# immediately, and the kernel drops those unrecoverable clean file-backed
# pages under memory pressure - which is what killed every short-video app
# (SIGSEGV SEGV_ACCERR in TRThread_0 / libglcore). On a tmpfs the same pages
# are shmem: reclaim swaps them into zram instead, so the driver's pointers
# stay valid. See mocha_app_cache_tmpfs.sh for the full analysis.
# Watch service: re-applies the cache tmpfs whenever the user-unlock CE
# remount clears it (a boot_completed one-shot exec is not enough - the
# remount happens after boot completes and wipes the mount).
service mocha_cache_tmpfs /system/bin/mocha_cache_tmpfsd --watch
    class late_start
    user root
    group root
