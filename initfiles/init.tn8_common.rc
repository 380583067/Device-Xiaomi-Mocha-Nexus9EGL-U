on post-fs-data
    # create /oem symbol link
    symlink /system/vendor/oem /oem
    chmod 0755 /oem
    chown root system /oem

    # create /lbh symbol link
    symlink /system/vendor/lbh /lbh
    chmod 0755 /lbh
    chown root system /lbh

    # hack to make hacked mipad GL blobs work (need /gl/libEGL_tegra.so path)
    symlink /system/lib/egl /gl
    chmod 0755 /gl
    chown root system /gl

    # Set SELinux security contexts for NvCPL keylayout files.
    mkdir /data/system/devices 0774 system system
    mkdir /data/system/devices/keylayout 0774 system system
    restorecon_recursive /data/system/devices/keylayout

on early-init
    write /sys/bus/i2c/devices/i2c-2/clock_rate 100000
    write /sys/bus/i2c/devices/i2c-2/retry_count 3
    write /sys/bus/i2c/devices/i2c-2/timeout 500000

on fs
    setprop ro.crypto.tmpfs_options size=128m,mode=0771,uid=1000,gid=1000
    setprop ro.crypto.umount_sd false
    setprop ro.crypto.fuse_sdcard true
    setprop audio.custompolicy 1
    # [2026-11-17] This used to create /dev/cpuset/camera-daemon and write its
    # cpus/mems. The kernel only enables CONFIG_CGROUPS, not CONFIG_CPUSETS
    # (enabling it hangs the boot on the MI logo), so /dev/cpuset never exists
    # and those mkdir/write calls failed on every boot and filled the log.
    # The framework creates the camera-daemon cpuset itself when cpuset is
    # available, so the block was dropped.

on boot
    #max resolution supported for Miracast is 1080p, represented interms of macroblocks
    setprop nvwfd.maxresolution_macroblocks 8160
    #enable Miracast game mode support
    setprop nvwfd.gamemode 1

on init
    setprop ro.feature.stylus 1
    setprop persist.tegra.cursor.enable 1
    setprop sf.async.cursor.enable 1
    setprop input.tch_blk.enabled 1
    setprop input.tch_blk.ext_for_ptrs 1
    setprop input.tch_blk.timeout_ms 500
    setprop input.tch_prs.ebc 0.9
    setprop input.tch_blk.edgeremap_left 10
    setprop input.tch_blk.edgeremap_top 5
    setprop input.tch_blk.edgeremap_right 15
    setprop input.tch_blk.edgeremap_bottom 5
    setprop input.ptr_trk.toolswitch_time 400
    setprop input.ptr_trk.toolswitch_range 200
    setprop input.ptr_trk.eraserlatch_range 10
    setprop input.ptr_trk.eraserdelay_time 250
    setprop input.ptr_trk.pinchtozoom_time 1000
    setprop input.ptr_trk.pinchtozoom_range 1100
    setprop input.ptr_trk.pinchtozoom_rectX 800
    setprop input.ptr_trk.pinchtozoom_rectY 1400
    setprop input.ptr_trk.pinchtozoom_cenX 600
    setprop input.ptr_trk.pinchtozoom_cenY 960
    setprop input.nonwhitelistedmode 3
    setprop keyguard.no_require_sim true
    setprop persist.tegra.didim.enable 0

    # [2026-11-21] page-cluster used to be 0 (one page read per swap-in), an
    # IO-saving setting from the era when swap lived on eMMC. This device mounts
    # a 1GB /dev/block/zram0 swap in fstab, so pages go in and out of RAM and a
    # one-page granularity only adds loop iterations and lock overhead; under
    # memory pressure (Android 14 on 2GB) that shows up as "slower the longer it
    # runs". Back to the kernel default of 3 (8 pages = 32KB).
    write /proc/sys/vm/page-cluster 3

    # This file used to contain:
    #     write /d/tegra_actmon/cpu_emc/avg_act_threshold 50000
    # kernel/xiaomi/mocha has no tegra_actmon debugfs node and /d does not even
    # exist (init.tegra.rc only mounts debugfs at /sys/kernel/debug), so that
    # write failed on every boot. Removed to keep the log clean and to avoid the
    # impression that EMC sampling was being configured.

service charger /system/bin/charger
    class charger
    critical
    user system
    group system graphics input
    capabilities SYS_BOOT
    seclabel u:r:charger:s0

service charger_led /system/bin/sh /system/bin/charger_led.sh
    class charger
    user root
    group root
    oneshot

on charger
    start charger_led

    # [2026-11-18] Off-mode charging gets stuck on the MI logo and the evidence
    # has to survive. Charger mode only runs the early-init / init / charger
    # triggers, never `on fs`, so /cache is normally NOT mounted - that is why
    # no charger log could ever be found (the logger service in init.tegra.rc is
    # class main and does not start in charger mode either). Mount the CAC
    # partition on /cache by hand and dump the kernel log (charger prints via
    # klog) plus the fb device state after 12 seconds, so the next system boot
    # or TWRP can read /cache/charger_dbg.txt directly.
    mkdir /cache 0770 system cache
    mount ext4 /dev/block/platform/sdhci-tegra.3/by-name/CAC /cache noatime nosuid nodev
    exec - root root -- /system/bin/sh -c "/system/bin/sleep 12; { echo '=== bootmode ==='; getprop ro.bootmode; echo '=== fb ==='; ls -la /dev/graphics/ 2>&1; echo '=== minui props ==='; getprop | grep -i minui; echo '=== klog ==='; dmesg; } > /cache/charger_dbg.txt 2>&1"

    # Diagnostics: let charger mode enumerate USB as well, so the host can see
    # the device when the cable is plugged in (best effort). This still depends
    # on adbd; switching the USB config just makes it observable.
    setprop sys.usb.config adb

    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
