on post-fs-data
    # create /oem symbol link
    symlink /system/vendor/oem /oem
    chmod 0755 /oem
    chown root system /oem

    # create /lbh symbol link
    symlink /system/vendor/lbh /lbh
    chmod 0755 /lbh
    chown root system /lbh

    # hack to make hacked mipad GL blobs work (need /gl/libEGL_tegra.so path)
    symlink /system/lib/egl /gl
    chmod 0755 /gl
    chown root system /gl

    # Set SELinux security contexts for NvCPL keylayout files.
    mkdir /data/system/devices 0774 system system
    mkdir /data/system/devices/keylayout 0774 system system
    restorecon_recursive /data/system/devices/keylayout

on early-init
    write /sys/bus/i2c/devices/i2c-2/clock_rate 100000
    write /sys/bus/i2c/devices/i2c-2/retry_count 3
    write /sys/bus/i2c/devices/i2c-2/timeout 500000

on fs
    setprop ro.crypto.tmpfs_options size=128m,mode=0771,uid=1000,gid=1000
    setprop ro.crypto.umount_sd false
    setprop ro.crypto.fuse_sdcard true
    setprop audio.custompolicy 1
    # [2026-11-17 fix] This used to create /dev/cpuset/camera-daemon and write its
    # cpus/mems. This kernel enables CONFIG_CGROUPS but not CONFIG_CPUSETS (enabling it
    # deadlocks the boot at the MI logo), so /dev/cpuset does not exist at all and the
    # mkdir/write failed on every boot and spammed the log. camera-daemon's cpuset is
    # created by the framework when cpusets are available, so these lines are gone.

on boot
    #max resolution supported for Miracast is 1080p, represented interms of macroblocks
    setprop nvwfd.maxresolution_macroblocks 8160
    #enable Miracast game mode support
    setprop nvwfd.gamemode 1

on init
    setprop ro.feature.stylus 1
    setprop persist.tegra.cursor.enable 1
    setprop sf.async.cursor.enable 1
    setprop input.tch_blk.enabled 1
    setprop input.tch_blk.ext_for_ptrs 1
    setprop input.tch_blk.timeout_ms 500
    setprop input.tch_prs.ebc 0.9
    setprop input.tch_blk.edgeremap_left 10
    setprop input.tch_blk.edgeremap_top 5
    setprop input.tch_blk.edgeremap_right 15
    setprop input.tch_blk.edgeremap_bottom 5
    setprop input.ptr_trk.toolswitch_time 400
    setprop input.ptr_trk.toolswitch_range 200
    setprop input.ptr_trk.eraserlatch_range 10
    setprop input.ptr_trk.eraserdelay_time 250
    setprop input.ptr_trk.pinchtozoom_time 1000
    setprop input.ptr_trk.pinchtozoom_range 1100
    setprop input.ptr_trk.pinchtozoom_rectX 800
    setprop input.ptr_trk.pinchtozoom_rectY 1400
    setprop input.ptr_trk.pinchtozoom_cenX 600
    setprop input.ptr_trk.pinchtozoom_cenY 960
    setprop input.nonwhitelistedmode 3
    setprop keyguard.no_require_sim true
    setprop persist.tegra.didim.enable 0

    # [2026-11-21 fix] page-cluster was 0 (one page read per swap-in), a leftover
    # from the era of swapping to eMMC, tuned to save IO. This device mounts a 1 GB
    # /dev/block/zram0, so swap in and out stays in RAM and a one-page granularity
    # only adds loop iterations and lock overhead; under memory pressure (A14 on 2 GB)
    # it shows up as "slower the longer you use it". Back to the kernel default 3
    # (8 pages = 32 KB).
    write /proc/sys/vm/page-cluster 3

    # There used to be one more line here:
    # This kernel (kernel/xiaomi/mocha) has no tegra_actmon debugfs node and not even
    # the /d symlink (init.tegra.rc only mounts debugfs at /sys/kernel/debug), so that
    # write failed on every boot. Removed to cut log noise and the false impression
    # that EMC sampling was being configured.

service charger /system/bin/charger
    class charger
    critical
    user system
    group system graphics input
    capabilities SYS_BOOT
    seclabel u:r:charger:s0
    # minui reports its framebuffer probe, its flips and every ioctl it fails on
    # through stdout, and init sends a service's stdout to /dev/null by default.
    # Without this there is no way to tell "never drew" from "drew somewhere
    # invisible" in charger mode, which is exactly the question being asked.
    stdio_to_kmsg

service charger_led /system/bin/sh /system/bin/charger_led.sh
    class charger
    user root
    group root
    oneshot

on charger
    start charger_led

    # Charger mode runs only early-init/init/charger, and `on charger` starts
    # nothing but class charger. servicemanager, hwservicemanager and
    # vndservicemanager all belong to class core, so none of them came up - and
    # the health HAL is a HIDL service (android.hardware.health@2.1) that
    # registers with hwservicemanager and is found through servicemanager. With
    # neither present it registered nowhere, libbatterymonitor never received a
    # battery reading, and the charger UI sat waiting while the panel kept
    # showing whatever the bootloader had left on it. That is exactly the
    # "charging is stuck on the MI logo" symptom: nothing draws, nothing fails.
    #
    # The HAL itself is already `class hal charger`, so it comes up on its own
    # as soon as there is somewhere to register. Order does not matter; the
    # HIDL client retries until the service appears.
    start servicemanager
    start hwservicemanager
    start vndservicemanager

    # Charger mode has no logcat, no /data and no boot log, so this file is the
    # only record of what the charger did. exec_background, not exec: `exec`
    # blocks init until the command returns, which would hold up everything
    # after it (including the USB setup below) for the full 60 s the collector
    # runs. Invoked through sh because PRODUCT_COPY_FILES installs 0644.
    mkdir /cache 0770 system cache
    mount ext4 /dev/block/platform/sdhci-tegra.3/by-name/CAC /cache noatime nosuid nodev
    exec_background - root root -- /system/bin/sh /system/bin/charger_dbg.sh

    # Nothing here touches sys.usb.config.
    #
    # It used to be set to "adb" so the device could be watched while charging,
    # but adbd is class core and never starts in this mode, so the property only
    # made init.usb.rc try to build a configfs gadget that has nothing to build
    # it: the log shows USB_STATE=CONNECTED/DISCONNECTED six times in one second
    # (t=11.89 to 12.77). On a dumb charger the port never enumerates and this
    # is invisible; plugged into a PC it fires continuously, and that is the one
    # situation where the charger showed nothing.

    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpu1/online 0
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
