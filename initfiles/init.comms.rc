on boot
    # UART device
    chmod 0660 /dev/ttyHS2
    chown bluetooth bluetooth /dev/ttyHS2
    chmod 0660 /dev/ttyTHS2
    chown bluetooth bluetooth /dev/ttyTHS2

    # power up/down interface
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/type
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type

    # bluetooth MAC address programming
    # 【2026-11-17 修正】原来这行是 `chown bluetooth bluetooth ro.bt.bdaddr_path`，
    # 把属性名当文件路径传给 chown，每次开机必报 no such file。属性本身无法 chown，
    # 真正需要可写的是 bt 地址文件，权限由 bt_vendor 自己处理，这里直接去掉。
    chown bluetooth bluetooth /system/etc/bluetooth

    # P2P device
    setprop wifi.direct.interface p2p-dev-wlan0

    # Wifi firmware reload path
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    
    setprop wifi.interface wlan0

on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/ctrl 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa_supplicant 0770 wifi wifi
        
service dns_masq /system/bin/dnsmasq --no-daemon --no-resolv --no-poll --dhcp-option-force=43,ANDROID_METERED --dhcp-range=192.168.42.2,192.168.42.254,1h
    class main
    user dhcp
    group dhcp wifi system
    disabled
    oneshot

# 修复说明：新增 uim 服务。brcm-uim-sysfs 是 Broadcom 蓝牙/FM 共享传输的
# 用户态初始化模块（UIM），拥有 ttyTHS2 串口，通过 /sys/devices/platform/bcm_ldisc/
# sysfs 通道与蓝牙芯片（BCM4354）通信，FM 功能依赖它建立 HCI 通道（BOARD_BRCM_HCI_NUM=26）。
# 原先缺失此服务，导致 FM 无法与蓝牙芯片通信。参考
# Dargons10/Device-Xiaomi-Mocha-Nexus9EGL-S 的 init.comms.rc。
# Owns ttyTHS2 for the Broadcom Bluetooth/FM shared transport.
service uim /vendor/bin/brcm-uim-sysfs
    class late_start
    user root
    group bluetooth net_bt
