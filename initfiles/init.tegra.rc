import /vendor/etc/init/hw/init.comms.rc

# This yields each tegra wdt expiration to be at 30 secs and fourth expiration for reboot at 120 secs.
#
# Fix (boot time, 2026-11-16):
# oneshot is required here. This service had none, and /dev/watchdog does not exist
# on this device (the dt has a wdt0 node and CONFIG_TEGRA_WATCHDOG=y, but
# tegra_wdt_probe never registers the character device and the kernel never logs
# "WDT heartbeat enabled on probe", so probe bailed out early). watchdogd therefore
# failed on every start, exited with status 1, and init restarted it forever with the
# default 5 s backoff: the boot log shows 9 restarts (11-15 21:16:38 through
# 21:17:14, i.e. the whole boot), each forking, creating a process group and logging
# a pile of errors.
# With oneshot it is tried once at boot and then ends quietly. This loses no watchdog
# protection: if a real hardware watchdog ever probes successfully /dev/watchdog will
# exist, and dropping oneshot then makes it resident again.
service watchdogd /system/bin/watchdogd 10 20
    class core
    user root
    group root system
    seclabel u:r:watchdogd:s0
    oneshot

# BPF
service bpfloader /system/bin/bpfloader
    class main
    capabilities CHOWN SYS_ADMIN NET_ADMIN
    disabled

on early-init
    chmod 0775 /sys/fs/bpf
    setprop bpf.progs_loaded 1
    mount debugfs debugfs /sys/kernel/debug mode=0755

on init
    # Camera fix: this used to be
    #     mkdir /dev/camera 0755 media camera
    # which created /dev/camera as an **empty directory** (this file came from the
    # vendor/Nexus 9 device tree, where that generation of the NVIDIA camera HAL did
    # put device nodes inside /dev/camera/). But the blob this device really uses
    # (camera.vendor.tegra.so) has NvcImager_Open calling open("/dev/camera") as a
    # character device, and hits the directory with:
    #     NvOsDebugPrintf: NvcImager_Open: Can not open camera device
    #                      /dev/camera: Is a directory
    # so get_number_of_cameras() returns 0, i.e. no cameras at all.
    # The kernel's node is /dev/camera.pcl (chr 10:53, see ueventd.tn8.rc), so the
    # directory is gone and a symlink is made in post-fs-data instead (see the end of
    # this file).
    mkdir /mnt/media_rw/sdcard1 0700 media_rw media_rw

    # Support legacy paths
    # symlink /sdcard /mnt/sdcard
    # symlink /sdcard /storage/sdcard0

    # create directory for mounting usb drives
    # mkdir /mnt/media_rw/usbdrive 0700 media_rw media_rw
    # mkdir /storage/usbdrive 0700 root root
    # symlink /mnt/media_rw/usbdrive /storage/usbdrive
    # symlink /mnt/media_rw/usbdrive /usbdrive

    # create directory for mounting calibration partition
    mkdir /mnt/vendor/factory 0666 system system
    mkdir /mnt/vendor/wifi_config 0666 system system

    # create directory for mounting user calibration partition
    mkdir /mnt/usercalib 0771 system system

    start watchdogd

    # Use Keymaster 0 HAL
    setprop ro.hardware.keystore tegra

on post-fs-data
    # Camera fix: NvcImager_Open in the NVIDIA camera blob hard-codes "/dev/camera"
    # while the Tegra kernel registers /dev/camera.pcl (chr 10:53). The device tree
    # used to mkdir /dev/camera in "on init", which made the blob log "Is a directory"
    # and get_number_of_cameras() return 0. It is a symlink now, created in
    # post-fs-data because by then ueventd has already created /dev/camera.pcl from the
    # kernel uevent.
    symlink /dev/camera.pcl /dev/camera
    mkdir /mnt/factory 0771 system system
    mkdir /mnt/factory/wifi 0770 system system

    mkdir /storage/sdcard1 0700 root sdcard_r

    # We chown/chmod /mnt/usercalib again so because mount is run as root + defaults
    chown system system /usercalib
    chmod 0771 /usercalib

    chown system system /mnt/vendor/wifi_config
    chmod 0666 /mnt/vendor/wifi_config

    # create the lost+found directories, so as to enforce our permissions
    mkdir /usercalib/lost+found 0770 root root

    # Set SELinux security contexts on upgrade or policy update.
    restorecon_recursive /usercalib

    mkdir /data/vendor/dhcp 0770 dhcp dhcp
    
    mkdir /data/vendor/hwc 0771 system graphics
    
    mkdir /data/vendor/mediadrm 0770 mediadrm mediadrm

    # create directory for camera calibration data
    mkdir /mnt/factory/camera 0666 system system

    # create directory for camera cached data
    mkdir /data/nvcam 0700 media camera

    chown dhcp dhcp /data/vendor/dhcp

    # Set indication (checked by vold) that we have finished this action
    setprop vold.post_fs_data_done 1

    # create directory for mediaserver EGL blob cache
    mkdir /data/vendor/mediaserver 0770 media media

    # backlight
    chown system system /sys/class/backlight/lcd-backlight/brightness

    # Boot log: clear the previous run's file, then start the logger (the service is
    # defined at the end of this file). Order matters - remove first, otherwise the
    # new log is deleted.
    rm /cache/boot_log.txt
    start logger

# Set up HDCP
import /vendor/etc/init/hw/init.hdcp.rc

on boot
    # Relabel GPU nodes
    restorecon /dev/nvmap
    restorecon /dev/nvhost-as-gpu
    restorecon /dev/nvhost-ctrl
    restorecon /dev/nvhost-ctrl-gpu
    restorecon /dev/nvhost-gpu
    restorecon /dev/nvhost-vic
    restorecon /dev/tegra-throughput
    restorecon /dev/tegra_dc_ctrl
    restorecon /dev/tegra_dc_0
    restorecon /dev/tegra_dc_1
    restorecon /sys/devices/platform/host1x/54200000.dc/enable
    restorecon /sys/devices/platform/host1x/54240000.dc/enable
    restorecon /sys/devices/platform/tegra12-i2c.0/i2c-0/0-002c/backlight/lcd-backlight/brightness
    restorecon /sys/devices/platform/tegra12-i2c.0/i2c-0/0-002c/backlight/lcd-backlight/max_brightness

    # Relabel cgroups
    restorecon_recursive /dev/stune

    # Relabel power management nodes
    restorecon /sys/devices/system/cpu/cpuquiet/tegra_cpuquiet/no_lp
    restorecon /sys/module/cpuidle_t11x/parameters/cpu_power_gating_in_idle
    
    # charger
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-1/1-006b/disabled_by_user

# Power management tweaks
    write /sys/module/bcmdhd/parameters/dhd_slpauto 0
    write /sys/module/tegra_core/parameters/lp0_state 0

    # dt2w
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-3/3-004a/wakeup_mode
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-3/3-0020/input/input0/wake_gesture
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-3/3-0020/input/input3/wake_gesture

# didim
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/enable
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/aggressiveness
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/sd_window
    chown system system /sys/devices/platform/host1x/tegradc.0/smartdimmer/sd_window_enable

    ## cmhw permissions
    # key disabler
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-3/3-004a/enable_keys
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-3/3-0020/input/input0/0dbutton
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-3/3-0020/input/input3/0dbutton

    # vibrator intensity / pattern playback (vibrator@1.3 HAL runs as system)
    chown system system /sys/vibrator/pwmvalue
    chown system system /sys/class/timed_output/vibrator/enable
    chmod 0660 /sys/class/timed_output/vibrator/enable
    chown system system /sys/class/timed_output/vibrator/pattern
    chmod 0660 /sys/class/timed_output/vibrator/pattern

    # CMU
    chown system system /sys/devices/platform/host1x/tegradc.0/cmu_enable
    chown system system /sys/devices/platform/host1x/tegradc.1/cmu_enable

    # power
    chown system system /sys/kernel/tegra_cap/core_cap_level
    chown system system /sys/kernel/tegra_cap/core_cap_state
    chown system system /sys/kernel/tegra_volt_cap/cpu_volt
    chmod 0664 /sys/kernel/tegra_volt_cap/cpu_volt
    chown system system /sys/module/cpu_tegra/parameters/cpu_user_cap
    chown system system /sys/devices/platform/host1x/gk20a.0/enable_3d_scaling

    # audio
    chmod 0664 /sys/power/suspend/mode
    chown system audio /sys/power/suspend/mode

# Tegra wakeup monitor
    chown system system /sys/devices/platform/tegra_wakeup_monitor/cmd
    chown system system /sys/devices/platform/tegra_wakeup_monitor/monitor_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/nf_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/am_enable
    chown system system /sys/devices/platform/tegra_wakeup_monitor/init_ports
    chown system system /sys/devices/platform/tegra_wakeup_monitor/add_ports
    chown system system /sys/devices/platform/tegra_wakeup_monitor/del_ports

# Sensor
    # LSM6DB0 (Mocha specific)
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_accel.0/enable
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_accel.0/fifo_enable
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_accel.0/sampling_frequency
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_gyro.0/enable
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_gyro.0/fifo_enable
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_gyro.0/sampling_frequency
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_magn.0/enable
    chown system system /sys/devices/platform/tegra12-i2c.0/i2c-0/0-0008/lsm6db0_magn.0/sampling_frequency

    chown system system /sys/class/sensors/light/device/amb_clear

# Touch
    chown system system /sys/class/input/input0/enabled
    chown system system /sys/class/input/input0/enable
    chmod 0660 /sys/class/input/input0/enable

# nvdps
    chown system system /sys/devices/platform/host1x/tegradc.0/nvdps
    chown system system /sys/class/graphics/fb0/device/nvdps

# ozwpan driver: WiFi direct USB shim driver
    chown system system /dev/ozwpan
    chown system system /sys/class/ozmo_wpan/ozwpan/devices
    chown system system /sys/class/ozmo_wpan/ozwpan/select
    chown system system /sys/class/ozmo_wpan/ozwpan/bind
    chmod 0660 /sys/class/ozmo_wpan/ozwpan/bind

# LP5521
    chown system system /sys/bus/i2c/drivers/lp5521/0-0032/select_engine
    chmod 0660 /sys/bus/i2c/drivers/lp5521/0-0032/select_engine
    chown system system /sys/bus/i2c/drivers/lp5521/0-0032/run_engine
    chmod 0660 /sys/bus/i2c/drivers/lp5521/0-0032/run_engine

# Set GL driver yield function to sleep for 250us
    setprop persist.tegra.yieldFunctionSlow 4

# TLK storage service
import /vendor/etc/init/hw/init.tlk.rc

# [2026-11-27 release cleanup] the ro.debuggable=1 debug-node chmod block
# (EMC debug interface + LSM6DB0 sensor nodes) was removed with the rest of
# the debugging-era mechanisms; on user builds it never fired anyway.

service bugreport /system/bin/dumpstate -d -p -B -z -o /data/user_de/0/com.android.shell/files/bugreports/bugreport
    class main
    disabled
    oneshot
    keycodes 116 115 114

# unified scaling setup
import /vendor/etc/init/hw/init.ussrd.rc

# [2026-11-27 release cleanup] The boot-phase logcat-to-/cache monitor
# (service logger writing /cache/boot_log.txt, stopped at boot_completed)
# was a debugging aid for the boot-animation loop chase and the
# enforcing bring-up. Removed for the public release: it logged every
# process continuously to a world-readable partition, and boot evidence
# now comes from /sys/fs/pstore and TWRP-side captures when needed.

# Userspace thermal guard: clamps scaling_max_freq before the kernel starts
# throttling at 84 C (see the header of the script). late_start so it begins
# once the profile from power.mocha.rc has been applied at boot_completed.
service mocha_thermal /system/bin/sh /vendor/bin/mocha_thermal.sh
    class late_start
    user root
    group root system
