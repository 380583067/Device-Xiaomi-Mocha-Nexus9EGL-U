import /vendor/etc/init/hw/init.tegra.rc
import /vendor/etc/init/hw/init.tn8_common.rc
import /vendor/etc/init/hw/init.t124.rc
import /vendor/etc/init/hw/init.cal.rc
import /vendor/etc/init/hw/init.tn8.usb.rc

on post-fs-data
    chmod 0644 /sys/kernel/cluster/active
    write /sys/class/gpio/export 61
    write /sys/class/gpio/gpio61/direction out
    write /sys/class/gpio/gpio61/value 0
    chown root system /sys/class/gpio/gpio61/value
    chmod 0664 /sys/class/gpio/gpio61/value
    mkdir /data/sensors 0777 system system
    chown system system /sys/devices/platform/host1x/tegradc.0/color_filter
    chown system system /sys/devices/platform/host1x/tegradc.0/color_filter_rgb
    chmod 0644 /sys/devices/platform/host1x/tegradc.0/color_filter
    chmod 0644 /sys/devices/platform/host1x/tegradc.0/color_filter_rgb

    chown system system /dev/sysmatdrv
    chmod 0660 /dev/sysmatdrv

on init
    # Mount a tmpfs into /mnt/tmp for hosting nvram, phs shared memory
    mkdir /mnt/tmp 0770 system system
    mount tmpfs tmpfs /mnt/tmp mode=0775,gid=1003

    setprop sys.esrd.powermon_path /sys/bus/i2c/devices/1-0008/iio_device
    setprop sys.esrd.powermon_channel 0
    setprop sys.esrd.min_esr 95
    setprop sys.esrd.max_esr 160
    setprop sys.esrd.margin 42
    setprop sys.esrd.nwindow 200
    setprop sys.esrd.ntry 600
    setprop sys.esrd.tsample 20
    setprop sys.esrd.delay_start 900
    setprop sys.esrd.delay_retry 900
    setprop sys.esrd.delay_ok 604800
    setprop sys.esrd.needed_coeff 0.97
    setprop sys.esrd.needed_var 300
    setprop sys.esrd.battery_thresh_high 60
    setprop sys.esrd.battery_thresh_low 15
    setprop sys.esrd.load_burst_duration 3
    setprop sys.esrd.check_screen_off 1
    chown system system /sys/power/sysedp/batmon/esr
    chown system system /sys/bus/i2c/devices/1-0040/iio_device/running_mode

on fs
    mount_all  /vendor/etc/fstab.tn8
    swapon_all /vendor/etc/fstab.tn8

on property:sys.boot_completed=1
    # Must run first: force GPU composition, otherwise the HWC glc_set /
    # NvGrDecompressBuffer path hangs the composer, init counts it as an updatable
    # crash and the device loops in userspace reboot (root cause of the boot-loop on
    # 2026-11-19, see the header of init.renderer.sh).
    start vendor.init_renderer
    write /sys/class/tty/ttyS0/console_write_enable 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    write /sys/block/mmcblk0/queue/iostats 1
    # Setup-wizard fallback (for old userdata where the SettingsProvider defaults no longer apply)
    start mocha_provision

on boot
    # change vm memory parameter
    write /proc/sys/vm/lowmem_reserve_ratio "128 128"

on post-fs
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/scheduler deadline
    write /sys/block/mmcblk0/queue/iosched/slice_idle 0
    write /sys/block/mmcblk0/queue/read_ahead_kb 2048

on property:apexd.status=ready
    mount none /system/etc/swcodec/ld.config.txt /apex/com.android.media.swcodec/etc/ld.config.txt bind

# [init fix 2026-11-17] `pm disable com.android.messaging` used to hang off
# `on property:ro.radio.noril=yes`, and system.prop sets yes while this matched
# against =true, so it never ran. Fixing the value would not help either: after the
# queue runs the `init` trigger, init immediately calls QueueAllPropertyActions()
# (init.cpp:1105) and by then PropertyLoadBootDefaults() has loaded the properties,
# so the action runs at the very start of boot when system_server /
# PackageManagerService are not up yet and pm must fail.
# mocha_provision handles it after boot_completed instead, see the service below.

# [setup wizard skip 2026-11-17] There were two root causes:
#   1) the real "provisioned" flag is Settings.Secure.user_setup_complete, and
#      LineageOS SetupWizard only looks at that (SetupWizardUtils.java:181). The old
#      code only wrote global.device_provisioned, so the wizard never went away.
#   2) an exec in `on property:sys.boot_completed=1` races with the wizard start, and
#      on the second boot (DB already present) it cannot fix anything either.
# The real fix writes the defaults when SettingsProvider creates its database, see
# overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml.
# The start mocha_provision above is only a fallback (old userdata with an existing
# DB where the defaults no longer apply).

# Fallback service: mark the device as provisioned and disable the SMS app, which
# is useless without a RIL. See /vendor/bin/mocha_provision.sh.
# Forced GPU composition: SurfaceFlinger's raw transaction 1008 is "Toggle forced
# GPU composition". That code is still live on A14; removing it returns to HWC
# composition and then the composer hangs -> userspace reboot loop.
service vendor.init_renderer /vendor/bin/init.renderer.sh
    user root
    oneshot

# user shell is deliberate: uid 2000 is the same as adb shell, and the permission
# behaviour of settings / pm is verified on the device; switching to system(1000)
# would need extra permission debugging.
service mocha_provision /system/bin/sh /vendor/bin/mocha_provision.sh
    user shell
    group shell
    disabled
    oneshot
