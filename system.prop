# ADB
# 修复说明：原先设备树缺少 ADB 相关属性，导致 persist.sys.usb.config 残留为纯 adb
# 模式，host 端 adb 授权握手异常，表现为 offline。补齐 USB 默认 mtp,adb 模式。
#
# 注意：ro.secure / ro.adb.secure / ro.debuggable 不能写在此处——它们由 build 系统
# 自动加入（main.mk 的 ADDITIONAL_SYSTEM_PROPERTIES 和 lineage common.mk 的
# PRODUCT_SYSTEM_DEFAULT_PROPERTIES），在此重复赋值会触发
# "found duplicate sysprop assignments" 编译错误。这些只读属性的覆盖改在
# lineage_mocha.mk 里用 filter-out 方式处理。
persist.service.adb.enable=1
persist.service.debuggable=1
persist.sys.usb.config=mtp,adb
persist.sys.root_access=2

# apex
ro.apex.updater.enabled=false

# AptX
persist.bt.enableAptXHD=true
persist.service.btui.use_aptx=1
persist.vendor.bt.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.audio.force_volume_scale=1

# BPF
ro.kernel.ebpf.supported=false
persist.net.bpf.stats=0
ro.net.bpf.enabled=false

# BT
ro.bt.bdaddr_path=/data/misc/bluetooth/mocha_btmacaddr.txt
persist.bluetooth.gd.enabled=false

# Charger
persist.sys.chgdisabled=0

# DIDIM
persist.tegra.didim.enable=1
persist.tegra.didim.video=5
persist.tegra.didim.normal=3

# DNS
# 【2026-11-19 域名解析偶发卡十几秒】家用路由的 RA 会把链路本地地址
# fe80::100 当首选 DNS 下发（LinkProperties 里是
# DnsAddresses=[fe80::100%wlan0, 192.168.2.1]），实测该地址 100% 不可达
# （IPv6 上游是断的，只有 RA 还在宣告）。netd 的解析器是串行试服务器的，
# 撞到死地址时每次尝试都要等满 RES_TIMEOUT（5 秒）才轮到下一个，
# 冷查询因此被拖到 13~20 秒。
# netd 允许用 device_config 覆盖这个重传间隔（见
# packages/modules/DnsResolver/res_cache.cpp：base_timeout_msec 为 0 时读
# netd_native 实验标志），这里把单次等待压到 1 秒。局域网/公网 DNS 正常
# 都在 200ms 内应答，不影响正常解析，而不可达的服务器最多只耽误 1 秒。
persist.device_config.netd_native.retransmission_time_interval=1000

# DRM
drm.service.enabled=true

# Fastbootd
ro.fastbootd.available=true

# Tegra GPU Driver
ro.hardware.egl=tegra
ro.hardware.gralloc=tegra
ro.hardware.hwcomposer=tegra
ro.hardware.vulkan=nvgpu

# Graphics
ro.opengles.version=196610
ro.sf.lcd_density=320
ro.input.noresample=1
ro.zygote.disable_gl_preload=true
persist.tegra.compression=0
persist.tegra.compositor=glcomposer
ro.surface_flinger.use_frame_rate_api=false
debug.sf.disable_hwc=0
ro.sf.use_hwc_vsync=1
# Force GPU composition from SurfaceFlinger start. The legacy Tegra K1 HWC
# blob hits a use-after-free in gralloc.nvgpu NvGrDecompressBuffer during
# heavy buffer-churn transitions (bootanim exit, launcher first frame):
# composer@2.1-se dies, SurfaceFlinger follows, and surfaceflinger.rc's
# "onrestart restart --only-if-running zygote" takes system_server down with
# it - which replays the boot animation on every cycle. With this property
# set, SF hands the composer no application buffers at all (equivalent to
# the manual "service call SurfaceFlinger 1008 i32 1" workaround, but
# effective from the very first frame).
persist.sf.force_gpu_composition=true
persist.tegra.decompression=disabled
persist.vendor.tegra.composite.policy=composite-yuv
persist.sys.ui.hw=true
debug.hwc.force_gpu=0
debug.sf.latch_unsignaled=0
#debug.sf.enable_gl_backpressure=0
debug.sf.disable_backpressure=0
debug.hwui.use_buffer_age=false
debug.renderengine.backend=gles

# Performance / thermal
# perf_profile: 0 power save, 1 balanced (default), 2 performance, 3 bias power
# save. power.mocha.rc maps it to governor/core/scheduler, mocha_thermal.sh uses
# it as the frequency ceiling. Switch with
#     setprop persist.mocha.perf_profile <n>
# and it survives a reboot.
persist.mocha.perf_profile=1
# Thermal guard: clamp above `threshold`, release below `resume` (millidegrees),
# clamped ceiling in kHz. The kernel's own passive trip is 84 C, which lets a
# fanless tablet get uncomfortably warm before anything happens.
persist.mocha.thermal.threshold=72000
persist.mocha.thermal.resume=66000
persist.mocha.thermal.cap_freq=1428000

# Lineage genuine
persist.lineage.nofool=true

# LMKD Memory Tuning for mocha 2GB, A14, use_minfree_levels mode
#
# 【2026-11-21 修正】先弄清这几个属性在 A14 里到底是什么含义
# （system/memory/lmkd/lmkd.cpp 的 update_props()）：
#   ro.lmk.low / medium / critical 是 **vmpressure 三个级别各自对应的
#   oom_score_adj 阈值**，取值范围 -1000~1000；默认 low=1001，而
#   "> OOM_SCORE_ADJ_MAX(1000)" 的语义是"该级别不杀进程"。
# 原配置写的是 8192 / 6144 / 4096 / 2048，全部越界，等于把 vmpressure 分级
# 彻底废掉；其中 ro.lmk.high 在 A14 的 lmkd 里连对应级别都不存在（只有
# VMPRESS_LEVEL_LOW/MEDIUM/CRITICAL），纯属死配置。
# 而且 use_minfree_levels=true 时判定走的是 framework 下发的 minfree 表
# （sys.lmk.minfree_levels），根本不会用这几个 oom_score_adj。
# 这里恢复成默认值（low 关闭），只保留真正生效的开关。
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.critical=0
ro.lmk.critical_upgrade=1
ro.lmk.upgrade_pressure=70
ro.lmk.downgrade_pressure=50
# lmkd 在 minfree 级别判定的候选集合里挑进程：开着这个开关时挑 RSS 最大的，
# 而 2GB 平板上"最大的那个"往往就是用户正在用的大型应用 —— 也就是"游戏自己
# 退出了"这类反馈的直接来源。关掉之后 lmkd 按调度顺序拿第一个符合 adj 条件的
# 进程（最可杀的那个），后台先死，前台大应用保住。
ro.lmk.kill_heaviest_task=0
ro.lmk.kill_timeout_ms=500
# 本内核没有 CONFIG_PSI（3.10 内核），PSI 模式必须关掉，否则 lmkd 拿不到压力
# 信号就只剩硬杀；minfree 模式是这台机器上唯一可用的路径。
ro.lmk.use_minfree_levels=true
ro.lmk.use_psi=false

# OMX Only (No Codec2)
persist.tegra.nvmmlite=1
persist.media.treble_omx=false

# We are using old omx blobs
media.stagefright.less-secure=true
media.stagefright.legacyencoder=true

# PBC Power Monitor (Disabled)
pbc.enabled=0
pbc.log=0
pbc.board_power_threshold=20000
pbc.low_polling_freq_threshold=1000
pbc.rails=cpu,core,dram,gpu
pbc.cpu.power=/sys/bus/i2c/devices/7-0045/power1_input
pbc.cpu.cap=/dev/cpu_freq_max
pbc.cpu.cap.af=/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies
pbc.core.power=/sys/bus/i2c/devices/7-0043/power1_input
pbc.dram.power=/sys/bus/i2c/devices/7-0049/power1_input
pbc.gpu.power=/sys/bus/i2c/devices/7-004b/power1_input
pbc.gpu.cap=/dev/gpu_freq_max
pbc.gpu.cap.af=/sys/devices/platform/host1x/gk20a.0/devfreq/gk20a.0/available_frequencies

# Radio
ro.radio.noril=yes

# SoC
ro.soc.manufacturer=NVIDIA
ro.soc.model=T124

# Storage
ro.sys.sdcardfs=true

# Wifi
persist.debug.wfd.enable=1
wifi.interface=wlan0
ap.interface=wlan0
persist.wlan.ti.calibrated=0

# Binary xml off
persist.sys.binary_xml=false

# Disable unlock
# 【2026-11-21 修正】原来写的是 false，但 ro.oem_unlock_supported 是 **int**
# 属性（framework 侧读的是 SystemProperties.getInt），开机日志里一直报：
#   E init: Do not have permissions to set 'ro.oem_unlock_supported' to 'false'
#           in property file '/system/build.prop': Property type check failed
# 也就是说这行从来没生效过。改成 0。
ro.oem_unlock_supported=0

# 【开机动画循环修复 2026-11-17】原厂 NVIDIA gralloc（Android 7/8 时代的 blob）
# 在 NvGrUnregisterBuffer 里会对一个已经关闭的 fd 再 close 一次（实测报
# "attempted to close file descriptor 0"）。Android 14 的 bionic 默认对该情况
# 直接 fdsan abort，于是 SurfaceFlinger 收到 SIGABRT → init 重启 SF →
# SF 启动时重新拉起开机动画 → 用户看到开机动画反复播放（四清后的第二次开机
# 尤其明显，因为此时 buffer 生命周期与首次开机不同）。
# bionic 支持用 debug.fdsan 属性调整这个检查的严重级别（见
# bionic/libc/bionic/fdsan.cpp 的 android_fdsan_set_error_level_from_property）：
#   warn_once = 只在第一次记一条日志，之后不再 abort
# 这样老的 gralloc blob 可以继续工作，不再把 SurfaceFlinger 打死。
debug.fdsan=warn_once
