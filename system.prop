# ADB
# The device tree had no ADB related properties, so persist.sys.usb.config was
# left at plain adb, the host side of the adb authorisation handshake failed and
# the device showed up as offline. Default to mtp,adb.
#
# Note: ro.secure / ro.adb.secure / ro.debuggable must not be set here - the
# build system adds them itself (ADDITIONAL_SYSTEM_PROPERTIES in main.mk and
# PRODUCT_SYSTEM_DEFAULT_PROPERTIES in lineage's common.mk) and duplicating them
# triggers a "found duplicate sysprop assignments" build error. Overrides for
# those read-only properties are handled in lineage_mocha.mk with filter-out.
persist.service.adb.enable=1
persist.service.debuggable=1
persist.sys.usb.config=mtp,adb
persist.sys.root_access=2

# apex
ro.apex.updater.enabled=false

# AptX
persist.bt.enableAptXHD=true
persist.service.btui.use_aptx=1
persist.vendor.bt.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac
persist.audio.force_volume_scale=1

# BPF
ro.kernel.ebpf.supported=false
persist.net.bpf.stats=0
ro.net.bpf.enabled=false

# BT
ro.bt.bdaddr_path=/data/misc/bluetooth/mocha_btmacaddr.txt
persist.bluetooth.gd.enabled=false

# Charger
persist.sys.chgdisabled=0

# DIDIM
persist.tegra.didim.enable=1
persist.tegra.didim.video=5
persist.tegra.didim.normal=3

# DNS
# [2026-11-19] DNS lookups occasionally stall for 10+ seconds. The home router
# advertises a link-local address, fe80::100, as the preferred DNS server
# (LinkProperties shows DnsAddresses=[fe80::100%wlan0, 192.168.2.1]) and that
# address is 100% unreachable here (IPv6 upstream is down, only the RA is still
# being sent). netd's resolver tries servers serially, so hitting the dead one
# costs a full RES_TIMEOUT (5s) before the next server is tried and a cold query
# ends up taking 13-20 seconds. netd lets device_config override the
# retransmission interval (see base_timeout_msec in
# packages/modules/DnsResolver/res_cache.cpp, which reads the netd_native
# experiment flag when it is 0), so the single attempt is capped at 1 second.
# LAN and public DNS both answer within 200ms, so normal resolution is
# unaffected and an unreachable server now costs at most one second.
persist.device_config.netd_native.retransmission_time_interval=1000

# DRM
drm.service.enabled=true

# Fastbootd
ro.fastbootd.available=true

# Tegra GPU Driver
ro.hardware.egl=tegra
ro.hardware.gralloc=tegra
ro.hardware.hwcomposer=tegra
ro.hardware.vulkan=nvgpu

# Graphics
ro.opengles.version=196610
ro.sf.lcd_density=320
ro.input.noresample=1
ro.zygote.disable_gl_preload=true
persist.tegra.compression=0
persist.tegra.compositor=glcomposer
ro.surface_flinger.use_frame_rate_api=false
debug.sf.disable_hwc=0
ro.sf.use_hwc_vsync=1
persist.sf.force_gpu_composition=0
persist.tegra.decompression=disabled
persist.vendor.tegra.composite.policy=composite-yuv
persist.sys.ui.hw=true
debug.hwc.force_gpu=0
debug.sf.latch_unsignaled=0
#debug.sf.enable_gl_backpressure=0
debug.sf.disable_backpressure=0
debug.hwui.use_buffer_age=false
debug.renderengine.backend=gles

# Lineage genuine
persist.lineage.nofool=true

# LMKD Memory Tuning for mocha 2GB, A14, use_minfree_levels mode
#
# [2026-11-21] First, what these properties mean on Android 14
# (update_props() in system/memory/lmkd/lmkd.cpp):
#   ro.lmk.low / medium / critical are the **oom_score_adj thresholds for the
#   three vmpressure levels**, range -1000..1000; the default for low is 1001,
#   and any value above OOM_SCORE_ADJ_MAX (1000) means "never kill at this
#   level".
# The previous values were 8192 / 6144 / 4096 / 2048, all out of range, which
# disabled the vmpressure grading entirely; ro.lmk.high has no matching level in
# the Android 14 lmkd at all (only VMPRESS_LEVEL_LOW/MEDIUM/CRITICAL), so it was
# dead configuration. With use_minfree_levels=true the decision is taken from the
# minfree table pushed by the framework (sys.lmk.minfree_levels) anyway, so
# these oom_score_adj values are not consulted.
# Restored to the defaults (low disabled) and only the switches that actually
# matter are kept.
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.critical=0
ro.lmk.critical_upgrade=1
ro.lmk.upgrade_pressure=70
ro.lmk.downgrade_pressure=50
ro.lmk.kill_heaviest_task=1
ro.lmk.kill_timeout_ms=500
# This kernel has no CONFIG_PSI (3.10 tree), so the PSI mode has to stay off -
# without a pressure signal lmkd would only have hard kills left. The minfree
# mode is the only usable path on this machine.
ro.lmk.use_minfree_levels=true
ro.lmk.use_psi=false

# OMX Only (No Codec2)
persist.tegra.nvmmlite=1
persist.media.treble_omx=false

# We are using old omx blobs
media.stagefright.less-secure=true
media.stagefright.legacyencoder=true

# PBC Power Monitor (Disabled)
pbc.enabled=0
pbc.log=0
pbc.board_power_threshold=20000
pbc.low_polling_freq_threshold=1000
pbc.rails=cpu,core,dram,gpu
pbc.cpu.power=/sys/bus/i2c/devices/7-0045/power1_input
pbc.cpu.cap=/dev/cpu_freq_max
pbc.cpu.cap.af=/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies
pbc.core.power=/sys/bus/i2c/devices/7-0043/power1_input
pbc.dram.power=/sys/bus/i2c/devices/7-0049/power1_input
pbc.gpu.power=/sys/bus/i2c/devices/7-004b/power1_input
pbc.gpu.cap=/dev/gpu_freq_max
pbc.gpu.cap.af=/sys/devices/platform/host1x/gk20a.0/devfreq/gk20a.0/available_frequencies

# Radio
ro.radio.noril=yes

# SoC
ro.soc.manufacturer=NVIDIA
ro.soc.model=T124

# Storage
ro.sys.sdcardfs=true

# Wifi
persist.debug.wfd.enable=1
wifi.interface=wlan0
ap.interface=wlan0
persist.wlan.ti.calibrated=0

# Binary xml off
persist.sys.binary_xml=false

# Disable unlock
# [2026-11-21] This used to be `false`, but ro.oem_unlock_supported is an int
# property (the framework reads it with SystemProperties.getInt) and the boot
# log kept reporting:
#   E init: Do not have permissions to set 'ro.oem_unlock_supported' to 'false'
#           in property file '/system/build.prop': Property type check failed
# so the line never took effect. Set it to 0.
ro.oem_unlock_supported=0

# [2026-11-17] The stock NVIDIA gralloc (blobs from the Android 7/8 era) closes
# an already closed fd again in NvGrUnregisterBuffer (observed as "attempted to
# close file descriptor 0"). Android 14's bionic aborts on that by default via
# fdsan, so SurfaceFlinger gets SIGABRT, init restarts it, and the restarted SF
# plays the boot animation again - the animation appears to loop (especially on
# the second boot after a full wipe, where buffer lifetimes differ from the
# first boot). bionic lets debug.fdsan set the severity of that check (see
# android_fdsan_set_error_level_from_property in
# bionic/libc/bionic/fdsan.cpp):
#   warn_once = log once, never abort afterwards
# so the old gralloc blob can keep running without killing SurfaceFlinger.
debug.fdsan=warn_once
