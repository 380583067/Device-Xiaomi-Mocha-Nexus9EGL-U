<resources>
    <string name="def_backup_transport">com.google.android.backup/.BackupTransportService</string>

    <!-- enable wifi by default, avoid gapps firstwizard FC -->
    <bool name="def_wifi_on">true</bool>

    <!-- Auto brightness mode is ON by default-->
    <bool name="def_screen_brightness_automatic_mode">true</bool>

    <!-- Doubletap2wake is OFF by default-->
    <bool name="def_double_tap_to_wake">false</bool>

    <!-- [setup wizard skip 2026-11-17] There is no usable setup-wizard flow on this
         device (no RIL, no GApps) and the first boot after a factory reset stays stuck
         in the LineageOS SetupWizard.
         The wizard's "done" test only looks at Settings.Secure.user_setup_complete
         (SetupWizardUtils.java:181) while the framework also wants
         global.device_provisioned.
         Writing both as true when SettingsProvider creates the database happens earlier
         than an exec settings in init and has no race: the first boot goes straight to
         the launcher. -->
    <bool name="def_device_provisioned">true</bool>
    <bool name="def_user_setup_complete">true</bool>
</resources>
