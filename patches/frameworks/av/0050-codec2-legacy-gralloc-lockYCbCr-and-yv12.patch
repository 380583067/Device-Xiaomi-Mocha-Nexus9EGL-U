+/* [mocha 2026-11-20] Debug override for the extra gralloc usage bits.
+ *
+ * Tegra's gralloc0 is very sensitive to usage bits: adding GPU-only bits
+ * (HW_RENDER / HW_COMPOSER, ...) makes lock()/lockYCbCr() on the same buffer
+ * return -ENOSYS (38), so the software decoder can no longer write its output;
+ * SurfaceFlinger on the other side insists on HW_TEXTURE (0x100) or it reports
+ * "buffer is not gpu readable" and blanks the layer. To try "CPU writable +
+ * GPU sampleable" combinations without a rebuild, a property switch is kept
+ * here; setprop and restart media.swcodec / mediaserver to switch:
+ *   debug.mocha.c2extra_usage=0x0     SW bits only (control baseline)
+ *   debug.mocha.c2extra_usage=0x100   HW_TEXTURE (default, verified on device)
+ *   debug.mocha.c2extra_usage=0x2100  HW_TEXTURE|EXTERNAL_DISP (as the OMX renderer)
+ * The default is used when the property is unset. Only applies to CPU_WRITE YUV
+ * buffers (decoder output). */
+static bool getDebugExtraUsage(uint64_t *out) {
+    char value[PROP_VALUE_MAX] = {};
+    if (__system_property_get("debug.mocha.c2extra_usage", value) <= 0) {
+        return false;
+    }
+    *out = strtoull(value, nullptr, 0);
+    return true;
+}
+
+static bool isYuvPixelFormat(uint32_t format) {
+    switch (format) {
+        case HAL_PIXEL_FORMAT_YV12:
+        case HAL_PIXEL_FORMAT_YCbCr_420_888:
+        case HAL_PIXEL_FORMAT_YCrCb_420_SP:
+        case HAL_PIXEL_FORMAT_YCbCr_422_SP:
+        case HAL_PIXEL_FORMAT_YCbCr_422_I:
+        case HAL_PIXEL_FORMAT_Y8:
+            return true;
+        default:
+            return false;
+    }
+}
+
+/* [mocha 2026-11-20] Only "CPU writable + YUV graphic" buffers (software
+ * decoder output) get HW_TEXTURE:
+ *  - without it SurfaceFlinger declares the buffer "not gpu readable" and
+ *    blanks the whole SurfaceView;
+ *  - adding it to BLOB (CSD / codec-specific data) buffers makes tegra gralloc
+ *    return -ENOSYS from lock(), and codec start() throws CodecException
+ *    (measured).
+ * That makes this format dependent, so it cannot live inside
+ * C2AndroidMemoryUsage::asGrallocUsage() (format is not available there). */
+static uint64_t getExtraGraphicUsage(uint32_t format, const C2MemoryUsage &usage) {
+    if (!(usage.expected & C2MemoryUsage::CPU_WRITE) || !isYuvPixelFormat(format)) {
+        return 0;
+    }
+    uint64_t extra;
+    if (!getDebugExtraUsage(&extra)) {
+        extra = GRALLOC_USAGE_HW_TEXTURE;
+    }
+    return extra;
+}
+
 uint64_t C2AndroidMemoryUsage::asGrallocUsage() const {
     // gralloc does not support WRITE_PROTECTED
-    return (((expected & C2MemoryUsage::CPU_READ) ? GRALLOC_USAGE_SW_READ_OFTEN : 0) |
+    uint64_t usage =
+            (((expected & C2MemoryUsage::CPU_READ) ? GRALLOC_USAGE_SW_READ_OFTEN : 0) |
             ((expected & C2MemoryUsage::CPU_WRITE) ? GRALLOC_USAGE_SW_WRITE_OFTEN : 0) |
             ((expected & C2MemoryUsage::READ_PROTECTED) ? GRALLOC_USAGE_PROTECTED : 0) |
             (expected & PASSTHROUGH_USAGE_MASK));
+    return usage;
 }
 
