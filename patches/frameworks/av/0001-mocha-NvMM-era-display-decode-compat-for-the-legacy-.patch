diff --git a/media/libstagefright/OmxInfoBuilder.cpp b/media/libstagefright/OmxInfoBuilder.cpp
index 79ffdeb894..301df0e646 100644
--- a/media/libstagefright/OmxInfoBuilder.cpp
+++ b/media/libstagefright/OmxInfoBuilder.cpp
@@ -154,6 +154,26 @@ status_t OmxInfoBuilder::buildMediaCodecList(MediaCodecListWriter* writer) {
         for (const IOmxStore::NodeInfo &node : role.nodes) {
             const hidl_string& nodeName = node.name;
 
+            /* 【录像修复 2026-11-17】过滤掉 NVIDIA 的 H.264 硬件编码器。
+             * 该组件来自 Android 7/8 时代的 libnvomx.so，在 Android 14 的
+             * ACodec 下 configureCodec 时查询 OMX_IndexParamVideoAvc 会直接
+             * 返回 InsufficientResources(0x80001000)，导致 MediaCodec
+             * 报 CodecException，相机录像 / screenrecord 全部失败。
+             * 注意：尝试过从 media_codecs.xml / media_codecs_performance.xml
