diff --git a/media/libstagefright/ACodec.cpp b/media/libstagefright/ACodec.cpp
index f9ceef24e2..bca9c44522 100644
--- a/media/libstagefright/ACodec.cpp
+++ b/media/libstagefright/ACodec.cpp
@@ -2062,6 +2062,20 @@ status_t ACodec::configureCodec(
                 return err;
             }
 
+            /* mocha 2026-11-20: the NVIDIA h264 decoder rejects metadata
+             * output entirely (storeMetaDataInBuffers -> NotImplemented;
+             * port mode DynamicANWBuffer -> failure that leaves the
+             * component in an error state, decode then fails with 0x8000
+             * 1000). Skip the whole metadata-mode negotiation here and let
+             * the sw-renderer branch below configure PresetByteBuffer
+             * output instead. */
+            if (mComponentName.startsWith("OMX.Nvidia.h264.decode")) {
+                /* 整段跳过：既不能走 DynamicANWBuffer 成功分支（会 CHECK
+                 * storingMetadataInDecodedBuffers() 直接 abort），也不能走
+                 * 失败回退分支（会尝试 adaptive playback）。 */
+                ALOGI("[%s] skipping metadata output negotiation",
+                        mComponentName.c_str());
+            } else {
             err = setPortMode(kPortIndexOutput, IOMX::kPortModeDynamicANWBuffer);
             if (err != OK) {
                 // if adaptive playback has been requested, try JB fallback
@@ -2113,6 +2127,7 @@ status_t ACodec::configureCodec(
                 CHECK(storingMetadataInDecodedBuffers());
                 inputFormat->setInt32("adaptive-playback", true);
             }
+            }   // end of the non-NVIDIA metadata negotiation
 
             int32_t push;
             if (msg->findInt32("push-blank-buffers-on-shutdown", &push)
@@ -2150,7 +2165,12 @@ status_t ACodec::configureCodec(
                 requiresSwRenderer = true;
             }
 
-            if (mComponentName.startsWith("OMX.google.") || requiresSwRenderer) {
+            /* 【mocha 硬解 2026-11-20】NVIDIA 的硬件解码器不支持
+             * DynamicANWBuffer / metadata-in-buffers，只接受 byte buffer；
+             * 强制走 SoftwareRenderer（GPU 显示，CPU 只做 YUV->RGB 转换）。 */
+            if (mComponentName.startsWith("OMX.google.")
+                    || requiresSwRenderer
+                    || mComponentName.startsWith("OMX.Nvidia.h264.decode")) {
                 usingSwRenderer = true;
                 haveNativeWindow = false;
                 (void)setPortMode(kPortIndexOutput, IOMX::kPortModePresetByteBuffer);
@@ -9217,6 +9237,31 @@ status_t ACodec::queryCapabilities(
                     OMX_IndexParamVideoProfileLevelQuerySupported,
                     &param, sizeof(param));
             if (err != OK) {
+                /* 【mocha 硬解 2026-11-20】libnvomx 不实现
+                 * ProfileLevelQuery（第一次查询即返回错误），上层因此永远
+                 * 选不中硬件解码器，720p 播放落到 CPU 软解。这里在首次查询
+                 * 失败时注入一份保守的 H.264 profile/level 列表，使
+                 * OMX.Nvidia.h264.decode 能被选中。列表只用于选择，不改变
+                 * 组件的实际行为；输出模式强制 byte buffer + sw renderer
+                 * （见 configureCodec 的同名补丁）。 */
+                if (!isEncoder
+                        && strcasecmp(mime, MEDIA_MIMETYPE_VIDEO_AVC) == 0
+                        && index == 0
+                        && strncmp(name, "OMX.Nvidia.", 11) == 0) {
+                    ALOGI("[%s] injecting H.264 profile levels for broken "
+                          "vendor blob", name);
+                    caps->addProfileLevel(OMX_VIDEO_AVCProfileBaseline,
+                                          OMX_VIDEO_AVCLevel3);
+                    caps->addProfileLevel(OMX_VIDEO_AVCProfileMain,
+                                          OMX_VIDEO_AVCLevel31);
+                    caps->addProfileLevel(OMX_VIDEO_AVCProfileHigh,
+                                          OMX_VIDEO_AVCLevel4);
+                    caps->addProfileLevel(
+                            OMX_VIDEO_AVCProfileConstrainedBaseline,
+                            OMX_VIDEO_AVCLevel3);
+                    caps->addProfileLevel(OMX_VIDEO_AVCProfileConstrainedHigh,
+                                          OMX_VIDEO_AVCLevel4);
+                }
                 break;
             }
             caps->addProfileLevel(param.eProfile, param.eLevel);
