From 0c12d8848214d46d9d2a127e516778f0fe8ac92a Mon Sep 17 00:00:00 2001
From: "github-actions[bot]" <github-actions[bot]@users.noreply.github.com>
Date: Mon, 23 Nov 2026 00:19:42 +0800
Subject: [PATCH 4/5] omx: SoftVideoEncoderOMXComponent lockYCbCr YV12 fallback
 for tegra gralloc

tegra's gralloc blob refuses lockYCbCr outright for YCbCr_420_888 and
YV12 buffers. Recording buffers land as YV12 through the gralloc shim
(BLOB reinterpretation), so the software encoder hit
'Error in extractGraphicBuffer' on the first frame and MediaRecorder
aborted one second in. Fall back to a plain lock and synthesize the
android_ycbcr with the pitch-linear YV12 layout (ystride=w, cstride=w/2,
V then U) - symmetric with the camera HAL writer and the gralloc shim's
own lock_ycbcr synthesis.
---
 .../omx/SoftVideoEncoderOMXComponent.cpp      | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/media/libstagefright/omx/SoftVideoEncoderOMXComponent.cpp b/media/libstagefright/omx/SoftVideoEncoderOMXComponent.cpp
index d75acdabf8..077643f0de 100644
--- a/media/libstagefright/omx/SoftVideoEncoderOMXComponent.cpp
+++ b/media/libstagefright/omx/SoftVideoEncoderOMXComponent.cpp
@@ -600,6 +600,32 @@ const uint8_t *SoftVideoEncoderOMXComponent::extractGraphicBuffer(
                  handle,
                  GRALLOC_USAGE_SW_READ_OFTEN | GRALLOC_USAGE_SW_WRITE_NEVER,
                  Rect(width, height), &ycbcr);
+        if (res != OK) {
+            /* 【mocha 2026-11-22 录像】tegra gralloc 的 lockYCbCr 对 YV12 一律
+             * -ENOSYS。MediaRecorder 的录像缓冲经 gralloc shim 以 YV12 落地
+             * （元数据仍标 35），编码器在这里锁不上就整个报错、录像 1 秒即死。
+             * 退化为普通 lock 并按 YV12（Y/V/U）手工铺平面 —— 与相机 HAL 写入
+             * 侧、C2 解码器 PopulatePlaneLayout 的回退完全对称。仅在本设备的
+             * 老厂 blob 上有意义；pitch-linear YV12 无填充，stride 取 width。 */
+            res = mapper.lock(
+                     handle,
+                     GRALLOC_USAGE_SW_READ_OFTEN | GRALLOC_USAGE_SW_WRITE_NEVER,
+                     Rect(width, height), &bits);
+            if (res == OK) {
+                ALOGW("lockYCbCr failed for %dx%d, fell back to plain lock "
+                      "assuming YV12 layout", width, height);
+                uint8_t *yBase = static_cast<uint8_t *>(bits);
+                memset(&ycbcr, 0, sizeof(ycbcr));
+                ycbcr.y = yBase;
+                ycbcr.ystride = width;
+                ycbcr.cr = yBase + static_cast<size_t>(width) * height;
+                ycbcr.cb = yBase + static_cast<size_t>(width) * height
+                         + static_cast<size_t>(width >> 1) * (height >> 1);
+                ycbcr.cstride = width >> 1;
+                ycbcr.chroma_step = 1;
+                res = OK;
+            }
+        }
     } else {
         res = mapper.lock(
                  handle,
