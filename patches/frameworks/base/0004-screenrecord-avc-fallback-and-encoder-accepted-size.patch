+    static boolean isHardwareHevcEncoderAvailable() {
+        for (MediaCodecInfo info : new MediaCodecList(MediaCodecList.REGULAR_CODECS).getCodecInfos()) {
+            if (!info.isEncoder() || !info.isHardwareAccelerated()) continue;
+            for (String type : info.getSupportedTypes()) {
+                if (MediaFormat.MIMETYPE_VIDEO_HEVC.equalsIgnoreCase(type)) return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * True when an encoder for {@code mime} advertises {@code profile} at {@code level} or
+     * better. MediaRecorder takes one profile/level pair for all candidates, so a single match
+     * is enough to know the value is accepted.
+     */
+    static boolean supportsProfileLevel(String mime, int profile, int level) {
+        for (MediaCodecInfo info : new MediaCodecList(MediaCodecList.REGULAR_CODECS).getCodecInfos()) {
+            if (!info.isEncoder()) continue;
+            for (String type : info.getSupportedTypes()) {
+                if (!type.equalsIgnoreCase(mime)) continue;
+                try {
+                    for (MediaCodecInfo.CodecProfileLevel pl
+                            : info.getCapabilitiesForType(type).profileLevels) {
+                        if (pl.profile == profile && pl.level >= level) return true;
+                    }
+                } catch (IllegalArgumentException ignored) {
+                    // Type not actually supported for this component.
+                }
+            }
+        }
+        return false;
+    }
