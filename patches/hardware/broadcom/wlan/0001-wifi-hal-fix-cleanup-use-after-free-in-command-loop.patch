+++ b/bcmdhd/wifi_hal/common.cpp
@@ -289,7 +289,16 @@ wifi_error wifi_cancel_cmd(wifi_request_id id, wifi_interface_handle iface)
 wifi_error wifi_get_cancel_cmd(wifi_request_id id, wifi_interface_handle iface)
 {
     wifi_handle handle = getWifiHandle(iface);
-    WifiCommand *cmd = wifi_get_cmd(handle, id);
+    /* [fix 2026-11-17] The old code used wifi_get_cmd() (lookup only, no
+     * removal) and then releaseRef()'d the command, which deletes it, without
+     * taking it out of info->cmd - leaving a dangling pointer in the array.
+     * The next wifi_cleanup walks that array and calls cancel()/releaseRef()
+     * on the freed object, whose vtable has already been reused as garbage
+     * (0x72646e61, "andr"); the CFI check then faults on an unmapped page and
+     * the wifi HAL crashes and restarts, replaying the boot animation.
+     * Use wifi_unregister_cmd() (remove and return) so the command is always
+     * out of the array before it is deleted, matching wifi_cancel_cmd(). */
+    WifiCommand *cmd = wifi_unregister_cmd(handle, id);
     ALOGV("Get Cancel WifiCommand = %p", cmd);
     if (cmd) {
         cmd->cancel();
diff --git a/bcmdhd/wifi_hal/wifi_hal.cpp b/bcmdhd/wifi_hal/wifi_hal.cpp
index af9b06c..bb08e58 100644
--- a/bcmdhd/wifi_hal/wifi_hal.cpp
+++ b/bcmdhd/wifi_hal/wifi_hal.cpp
@@ -710,13 +710,34 @@ void wifi_cleanup(wifi_handle handle, wifi_cleaned_up_handler cleaned_up_handler
             ALOGI("Cancelling command %p:%s", cmd, cmd->getType());
             pthread_mutex_unlock(&info->cb_lock);
             cmd->cancel();
-            if (num_cmd == info->num_cmd) {
-                ALOGI("Cancelling command %p:%s did not work", cmd, (cmd ? cmd->getType(): ""));
-                bad_commands++;
+            pthread_mutex_lock(&info->cb_lock);
+            /* [fix 2026-11-17] cancel() can fail or return early (for example
+             * HalInit::cancel returns immediately when the LOGGER_HAL_STOP
+             * command cannot be created or sent, skipping the
+             * wifi_unregister_cmd() at its end), leaving the command inside
+             * info->cmd. The old code only bumped bad_commands and moved on,
+             * but the releaseRef() below then deleted the object anyway -
+             * leaving a dangling pointer in the array. The next access (or the
+             * next cleanup) found a vtable reused as garbage (0x72646e61,
+             * "andr") and the CFI check faulted on an unmapped page.
+             *
+             * Fix: if cancel() left the command in place (it did not unregister
+             * itself), remove it here explicitly so it is always out of the
+             * array before releaseRef() deletes it. */
+            if (info->num_cmd > bad_commands &&
+                    info->cmd[bad_commands].cmd == cmd) {
+                memmove(&info->cmd[bad_commands],
+                        &info->cmd[bad_commands + 1],
+                        (info->num_cmd - bad_commands - 1) * sizeof(cmd_info));
+                info->num_cmd--;
             }
             /* release reference added when command is saved */
+            pthread_mutex_unlock(&info->cb_lock);
             cmd->releaseRef();
             pthread_mutex_lock(&info->cb_lock);
+        } else {
+            /* Defensive: skip empty slots instead of looping forever */
+            bad_commands++;
         }
     }
 
@@ -731,6 +752,14 @@ void wifi_cleanup(wifi_handle handle, wifi_cleaned_up_handler cleaned_up_handler
     }
     pthread_mutex_unlock(&info->cb_lock);
 
+    /* [fix 2026-11-17] clean_up must be set after this loop, with cb_lock
+     * released. If it were set earlier, the event loop thread could take an
+     * nl80211 event during the loop, leave poll, run
+     * internal_cleaned_up_handler() and free the interface and hal_info while
+     * this loop is still dereferencing info->cmd - a use-after-free (observed
+     * as cmd id=0 with the vtable overwritten to 0x72646e61, "andr"). With it
+     * here the event loop stays blocked in poll until the
+     * write(cleanup_socks[0]) below, so the ordering is safe. */
     info->clean_up = true;
 
     /* global func ptr be invalidated and will not call any command from legacy hal */
diff --git a/bcmdhd/wifi_hal/wifi_logger.cpp b/bcmdhd/wifi_hal/wifi_logger.cpp
index 694df19..d9acae6 100755
--- a/bcmdhd/wifi_hal/wifi_logger.cpp
+++ b/bcmdhd/wifi_hal/wifi_logger.cpp
@@ -2058,10 +2058,22 @@ wifi_error wifi_stop_ring_dump(wifi_interface_handle iface)
 
 wifi_error wifi_stop_hal(wifi_interface_handle iface)
 {
-    HalInit *cmd = new HalInit(iface, HAL_START_REQUEST_ID);
-    NULL_CHECK_RETURN(cmd, "memory allocation failure", WIFI_ERROR_OUT_OF_MEMORY);
-    cmd->cancel();
-    cmd->releaseRef();
+    /* [fix 2026-11-17] The old implementation new'ed a temporary HalInit and
+     * cancelled it, which had two problems:
+     * 1) wifi_hal_preInit() and wifi_start_hal() both register a HalInit with
+     *    id=HAL_START_REQUEST_ID, so the array holds two commands with the same
+     *    id. HalInit::cancel() ends with wifi_unregister_cmd() by id, which
+     *    removes only the first match - cancelling the temporary command thus
+     *    removed the array's first HalInit (without deleting it, so it leaked)
+     *    and corrupted the array state.
+     * 2) new HalInit(iface) dereferences iface (wlan0Handle) in its
+     *    constructor, and during cleanup that handle may already be dangling.
+     *
+     * The real side effect of cancel() (sending LOGGER_HAL_STOP to the driver)
+     * is performed by the genuine HalInit::cancel() from the array, inside the
+     * wifi_cleanup loop below, so returning success here is enough - no
+     * temporary command should be created. */
+    (void)iface;
     return WIFI_SUCCESS;
 }
 
