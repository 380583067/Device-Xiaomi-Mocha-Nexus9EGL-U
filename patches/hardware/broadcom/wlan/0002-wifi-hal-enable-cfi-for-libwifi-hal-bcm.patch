+++ b/bcmdhd/wifi_hal/Android.bp
@@ -43,6 +43,44 @@ wifi_cc_defaults {
 cc_library_static {
     name: "libwifi-hal-bcm",
 
+    // ========================================================================
+    // CFI consistency fix (found on device 2026-11-16; fixes the wifi HAL crash
+    // and the resulting boot animation loop)
+    //
+    // Background: the final artifact libwifi-hal.so
+    //   (frameworks/opt/net/wifi/libwifi_hal/Android.bp) explicitly enables
+    //   sanitize: { cfi: true, integer_overflow: true }, and this module is one
+    //   of its whole_static_libs dependencies.
+    //
+    // Problem: Soong does NOT propagate sanitize settings through
+    //   whole_static_libs into a static library. Functions compiled here
+    //   (wifi_cleanup() and friends) therefore have no CFI type hash in their
+    //   prologue, while the call sites inside libwifi-hal.so
+    //   (WifiLegacyHal::stop) still perform the CFI check. The check reads the
+    //   function's machine code as if it were the type hash, cannot match, and
+    //   goes to __cfi_slowpath -> abort.
+    //
+    // Crash stack on device (/vendor/bin/hw/android.hardware.wifi@1.0-service.legacy):
+    //   #00 libdl.so (__cfi_slowpath+14)
+    //         r0=0x98a318fe r1=0x826cd3ae  <- two different type hashes, proof
+    //   #01 libwifi-hal.so (wifi_cleanup.cfi+800)
+    //   #02 WifiLegacyHal::stop(...)+306
+    //
+    // Knock-on effect (the real driver of the "boot animation loop"):
+    //   wifi HAL is aborted
+    //     -> system_server's WifiHalHidlImpl.registerHalCallback gets a null IWifi
+    //     -> java.lang.NullPointerException: Attempt to invoke interface method
+    //       'IWifi.registerEventCallback(...)' on a null object reference
+    //     -> FATAL EXCEPTION IN SYSTEM PROCESS -> the whole framework restarts
+    //        -> boot animation replays
+    //
+    // Fix: build this module with the same CFI settings as libwifi-hal so the
+    //   entry points carry the correct type hash and the check passes.
+    // ========================================================================
+    sanitize: {
+        cfi: true,
+    },
+
     cflags: [
         "-Wall",
         "-Werror",
