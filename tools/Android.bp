// mocha gralloc YUV lock diagnostic tool (debug only, never shipped in release builds)
cc_binary {
    name: "yv12locktest",
    srcs: ["yv12locktest.cpp"],
    shared_libs: [
        "libui",
        "libutils",
        "liblog",
        "libcutils",
        "libnativewindow",
    ],
    cflags: ["-Wno-unused-parameter"],
    vendor: false,
}
