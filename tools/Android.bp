// mocha gralloc YUV lock 能力诊断工具（临时调试用，不随正式版本发布）
cc_binary {
    name: "yv12locktest",
    srcs: ["yv12locktest.cpp"],
    shared_libs: [
        "libui",
        "libutils",
        "liblog",
        "libcutils",
        "libnativewindow",
    ],
    cflags: ["-Wno-unused-parameter"],
    vendor: false,
}
