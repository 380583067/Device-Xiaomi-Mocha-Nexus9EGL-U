/*
 * FM fix (2026-11-16):
 *
 * This module used to live in Android.mk in the same directory
 * (LOCAL_MODULE := libfmjni, LOCAL_VENDOR_MODULE := true). That cannot work on
 * Android 14, because packages/apps/FMRadio/Android.bp has:
 *
 *     android_app {
 *         name: "FMRadio",
 *         jni_libs: ["libfmjni"],
 *         ...
 *     }
 *
 * jni_libs is a **Soong** property and only resolves Soong modules. A Make module
 * (Android.mk) is invisible to it, which fails outright with:
 *
 *     error: packages/apps/FMRadio/Android.bp: FMRadio depends on
 *            undefined module "libfmjni"
 *
 * That is the real reason BOARD_HAVE_BCM_FM had to fall back to false in
 * BoardConfig.mk.
 *
 * packages/apps/FMRadio/jni/fmr/Android.bp also ships a **MediaTek** libfmjni
 * (for MediaTek FM chips, completely incompatible with this Broadcom BCM4354).
 * Both have the same name and are separated by a Soong namespace:
 *   - that directory carries soong_namespace {} and is only visible when
 *     vendor/lineage/config/BoardConfigSoong.mk adds
 *     packages/apps/FMRadio/jni/fmr to PRODUCT_SOONG_NAMESPACES;
 *   - BoardConfig.mk sets BOARD_HAVE_MTK_FM := true to turn that branch off, so
 *     the MTK one is not built and this file's libfmjni is the only one.
 *
 * Installed to /system/lib (no vendor: true):
 *   1) FMRadio is a platform-signed system app, so jni_libs can only reference
 *      libraries visible to platform; vendor libraries are not, and
 *      check_platform_availability fails.
 *   2) At run time libfmjni dlopens libfmradio.v4l2-fm.so with a path hard-coded
 *      to the same directory. Keeping both in /system/lib keeps them reachable
 *      from the app process's classloader namespace (the app namespace's
 *      permitted.paths includes /system/lib but not necessarily /vendor/lib, and
 *      a cross-namespace load is refused by the linker with "not accessible for
 *      the namespace").
 */
cc_library_shared {
    name: "libfmjni",

    srcs: [
        "android_fm.cpp",
        "android_fmradio_Receiver.cpp",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        // android_fm.cpp scans this directory for libfmradio.<variant>.so, so this
        // must match where libfmradio.v4l2-fm is installed.
        "-DLIBRARY_PATH=\"/system/lib/\"",
    ],

    header_libs: [
        "jni_headers",
        "libnativehelper_header_only",
    ],

    shared_libs: [
        "liblog",
        "libnativehelper",
    ],

    // libfmradio.v4l2-fm is dlopen'ed, not a link dependency, but it still has to be
    // installed into the image.
    required: [
        "libfmradio.v4l2-fm",
        "brcm-uim-sysfs",
    ],
}
