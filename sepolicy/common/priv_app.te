# upnpfuse
allow priv_app vold:fifo_file { read write getattr };
allow priv_app upnpfuse_cache_file:dir create_dir_perms;
allow priv_app upnpfuse_cache_file:file create_file_perms;

allow priv_app storage_stub_file:dir getattr;

allow priv_app system_app_service:service_manager find;

# Allow netcfg/mmc_host access
r_dir_file(priv_app, sysfs_netcfg)
r_dir_file(priv_app, sysfs_mmc_host)

# Read /data/data subdirectory.
#allow priv_app system_app_data_file:file r_file_perms;
# Read /mnt/asec/<pkg-cid>/base.apk which is mounted from app on sdcard (asec)
allow priv_app asec_apk_file:file r_file_perms;

# Allow getattr access permission to app specific directories
allow priv_app system_app_data_file:dir getattr;
# Read filesystem metadata from the device tree's declared factory mount type.
allow priv_app factory_file:filesystem getattr;

# /dev/tegra-throughput: Launcher3's RenderThread r/w it every frame.
allow priv_app tegra_throughput_device:chr_file rw_file_perms;
# Launcher3's RenderThread (GL stack) connects to the NV phsd power socket
# just like the other allow_use_phs users. Observed: denied { write } for
# name="phsd" socket_device:sock_file (socket now labelled phsd_socket).
allow_use_phs(priv_app)

# [enforcing bring-up 2026-11-26] The NV GL/HWC stack read by Launcher3's
# RenderThread identifies the SoC through /sys/devices/soc0/...-style nodes
# labelled sysfs_tegra_info. Observed: denied { read } for name="tegra_chip_id".
allow priv_app sysfs_tegra_info:file r_file_perms;
