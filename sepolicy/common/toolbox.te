allow toolbox ram_device:blk_file { read write open getattr }; 
# The thermal guard reads zone temperatures here (mocha_thermal.sh runs through
# init as toolbox): 31 "avc: denied" per boot on sysfs_thermal.
r_dir_file(toolbox, sysfs_thermal)

# getprop from the thermal guard and the diagnostic scripts reads vendor
# properties (18 denials per boot reading vendor_default_prop).
get_prop(toolbox, vendor_default_prop)
