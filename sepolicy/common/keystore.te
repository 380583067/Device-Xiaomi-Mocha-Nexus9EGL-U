# Allow to write to nvfeedback log file
allow keystore anr_data_file:file write;

# Android 14's keystore service uses the platform `keystore` domain and the
# platform hal_keymaster client rules. Mocha packages the HIDL Keymaster 4.1
# service; it does not define a `keystore2` vendor domain or `keymint_device`
# type. Keep device access on the HAL side, where AOSP grants the standard
# tee_device permissions to hal_keymaster_server.
