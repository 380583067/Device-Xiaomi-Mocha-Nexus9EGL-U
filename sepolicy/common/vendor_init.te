allow vendor_init camera_data_file:dir create_dir_perms;
allow vendor_init gps_data_file:dir create_dir_perms;
allow vendor_init nfc_data_file:dir create_dir_perms;

# init.tlk.rc creates these vendor secure-storage directories at post-fs-data.
# Use Android 14's existing TEE data type rather than the undefined tlk_data_file.
allow vendor_init tee_data_file:dir create_dir_perms;

allow vendor_init kernel:process setsched;
allow vendor_init self:capability sys_nice;

allow vendor_init camera_data_file:file create_file_perms;
allow vendor_init proc:file write;
allow fsck block_device:blk_file { read open write ioctl };
allow vendor_init system_data_file:dir { write add_name create setattr };
allow vendor_init system_data_file:dir { read open };

# 允许vendor_init域读取apexd属性
allow vendor_init apexd_prop:file read;

# HWC permissions belong to common/hal_graphics_composer_default.te; do not
# place HAL rules in the vendor_init domain policy.
