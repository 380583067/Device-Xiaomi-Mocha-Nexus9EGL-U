# Mocha has no ril_db_file type or matching file_contexts path. Keep RIL
# database access disabled until a concrete database location is declared.

# Connect to qmuxd without relying on the Qualcomm-only qmux_socket m4 macro.
allow rild qmuxd_socket:dir create_dir_perms;
unix_socket_connect(rild, qmuxd, qmuxd)
allow rild qmuxd_socket:sock_file { read getattr write setattr create unlink };

# Read/Write to uart driver (for GPS)
allow rild gps_device:chr_file rw_file_perms;
