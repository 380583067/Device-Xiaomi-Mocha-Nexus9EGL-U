# adb_selfcheck.sh - adb 自检脚本的 SELinux 策略
# 脚本职责：开机后检测 adbd USB transport 是否正常，异常时 reboot recovery。
type adb-selfcheck, domain;
type adb-selfcheck_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(adb-selfcheck)

# 执行 /vendor/bin/sh（脚本解释器，#!/vendor/bin/sh）
allow adb-selfcheck vendor_shell_exec:file rx_file_perms;

# 执行 toolbox 命令：pidof、log、getprop、setprop、reboot 均在 /system/bin/toolbox
allow adb-selfcheck toolbox_exec:file rx_file_perms;

# 修复说明（2026-11-16 真机实测）：
# 本机 toolbox 是从 /system/vendor/bin/toybox_vendor 提供的（TN8 的老布局，
# /vendor 就是 /system/vendor），所以实际被执行的文件带上 vendor 标签。
# 只给 toolbox_exec 会漏，实测开机必然出现：
#     avc: denied { execute_no_trans } for comm="adb_selfcheck.s"
#          path="/system/vendor/bin/toybox_vendor"
#          scontext=u:r:adb-selfcheck:s0 tcontext=u:object_r:vendor_toolbox_exec:s0
# permissive 下不致命，但 enforcing 会让自检脚本直接跑不起来（等于失去了
# "adb 挂了自动重启到 TWRP" 这层保险），所以这里补上。
allow adb-selfcheck vendor_toolbox_exec:file rx_file_perms;

# 读取属性 sys.boot_completed（getprop）
get_prop(adb-selfcheck, boot_status_prop)

# 读 logcat（判断 adbd 是否有 transport 注册之后的进展）
read_logd(adb-selfcheck)

# reboot recovery（写 sys.powerctl，由 reboot 命令触发）
set_prop(adb-selfcheck, powerctl_prop)
