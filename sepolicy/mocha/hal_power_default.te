# The interactive governor nodes (boostpulse, io_is_busy, tunables) and the
# CPU frequency ceilings the camera hints cap both live under
# /sys/devices/system/cpu, which genfscon labels sysfs_devices_system_cpu.
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;

# Reading the profile properties; the battery-saver switch is written by the
# HAL itself (see power.mocha.rc for the consumer side).
get_prop(hal_power_default, vendor_default_prop)
get_prop(hal_power_default, system_prop)
