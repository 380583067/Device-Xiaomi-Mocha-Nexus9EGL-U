# /sys/devices/virtual/input: system_server's InputManager reads name/enable for
# every input device it registers. Two denials per device per boot on the
# generic sysfs type.
type sysfs_input, fs_type, sysfs_type;

allow system_server sysfs_input:dir r_dir_perms;
allow system_server sysfs_input:file rw_file_perms;
