# The composer is the only process that opens /dev/tegra_dc_0 (verified against
# the boot log: all 32 "avc: denied { ioctl }" lines on that node come from
# hal_graphics_composer_default). Now that file_contexts labels the node
# tegradc_device instead of the generic device type, it needs the permission
# explicitly - surfaceflinger, system_server and system_app already had theirs.
allow hal_graphics_composer_default tegradc_device:chr_file rw_file_perms;
