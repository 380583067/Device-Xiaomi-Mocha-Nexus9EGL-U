# brcm-uim-sysfs - the user-space initialisation process (UIM) of the Broadcom
# Bluetooth/FM shared transport
#
# FM fix (2026-11-16):
# The binary always existed in the device tree (device/xiaomi/mocha/fm/
# brcm-uim-sysfs) and init.comms.rc had a service for it (class late_start, user
# root, group bluetooth net_bt), but BOARD_HAVE_BCM_FM=false meant it was never
# built, let alone installed, so it never ran - the first reason FM was completely
# unusable.
#
# What it does: through the sysfs nodes of the bcm_ldisc driver (install /
# vendor_params / snoop_enable / bdaddr / fw_patchfile) it pushes patchram
# parameters to the BCM4354, drives the chip's power sequence and moves it from
# "Bluetooth HCI mode" to "UIM/FM mode". Only then can libfmradio.v4l2-fm
# open("/dev/radio0") and talk to the chip.
#
# This file used to hold one line, "type uim, domain;" (and nothing gave uim an
# exec_type, so init_daemon_domain was unusable and the process really fell into
# the init domain). Completed here with:
#   - the uim_exec executable type (file_contexts maps it to /vendor/bin/brcm-uim-sysfs)
#   - init_daemon_domain, so init switches from uim_exec into the uim domain
#   - a minimal access set: read bt_vendor.conf, read/write the bcm_ldisc sysfs, open the BT UART
#
# SELinux is permissive here (BoardConfig: androidboot.selinux=permissive), so these
# rules do not really deny anything yet, but they matter because:
#   1) uim really runs in its own domain instead of init (clearer logs);
#   2) nothing has to be written from scratch when enforcing is switched on;
#   3) there is less permissive=1 avc denial noise during boot (each one writes logd, which costs IO).

type uim, domain;
type uim_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(uim)

# Read /system/etc/bluetooth/bt_vendor.conf (UimUartPort / UartBaudRate /
# FwPatchFileName / LpmEnable and friends come from that file).
allow uim system_file:file r_file_perms;

# The bcm_ldisc sysfs channel: install, vendor_params, snoop_enable, bdaddr,
# fw_patchfile. uim reads state and writes parameters, so the directory needs search
# and the files need read/write.
allow uim sysfs:dir search;
allow uim sysfs:file rw_file_perms;

# ==== The critical bit: chip power-on (FM, measured on the device 2026-11-16) ====
#
# uim powers the BT/FM core of the BCM4354 by writing
#     /sys/class/rfkill/rfkill0/state        (u:object_r:sysfs_bluetooth_writable)
# That rfkill comes from the bluedroid_pm driver (name=bluedroid_pm) and ends up at
# shutdown_gpio = TEGRA_GPIO_PR1 (BT_REG_ON) in board-mocha.c.
#
# Measured: with PR1 low ("gpio-137 (shutdown_gpio) out lo" in
# /sys/kernel/debug/gpio) the BT core has no power and an HCI Reset on /dev/ttyTHS2
# gets no answer from any of the four ttyTHS; after writing state=1 the answer
# arrives immediately
#     04 0e 04 01 03 0c 00        (Command Complete for HCI Reset)
# i.e. without this write permission FM (and Bluetooth) can never come up.
#
# The old sysfs:file rule did not cover the sysfs_bluetooth_writable attribute type,
# so permissive mode let it slip through and enforcing would fail outright.
allow uim sysfs_bluetooth_writable:file rw_file_perms;

# Bluetooth UART: UartPort = /dev/ttyTHS2 in bt_vendor.conf
allow uim tty_device:chr_file rw_file_perms;

# ==== Property access (2026-11-16, added after testing on a clean image) ====
#
# After adding the tty_device label and sysfs_bluetooth_writable, the only avc
# denials left for uim were the two property reads below (harmless in permissive,
# fatal when enforcing):
#
#   avc: denied { read } name="u:object_r:default_prop:s0"
#       scontext=u:r:uim:s0 tcontext=u:object_r:default_prop:s0 tclass=file
#   avc: denied { read } name="u:object_r:exported_bluetooth_prop:s0"
#       scontext=u:r:uim:s0 tcontext=u:object_r:exported_bluetooth_prop:s0 tclass=file
#
# During init uim looks up Bluetooth configuration (chip model, bdaddr path) over the
# generic property channel, which is why it touches the untyped default_prop, and
# parsing bt_vendor.conf reads exported_bluetooth_prop (ro.bt.xxx and such).
# get_prop rather than a bare allow, so the AOSP get_prop permission set is used.
get_prop(uim, default_prop)
get_prop(uim, exported_bluetooth_prop)

# libnetutils / socket (uim links against libnetutils)
allow uim self:capability { net_admin net_raw };
allow uim self:{ rawip_socket tcp_socket udp_socket } { create ioctl read write getattr setopt };
