# brcm-uim-sysfs —— Broadcom 蓝牙/FM 共享传输的用户态初始化进程（UIM）
#
# 修复说明（FM，2026-11-16）：
# 这个可执行文件一直存在于设备树（device/xiaomi/mocha/fm/brcm-uim-sysfs），
# init.comms.rc 里也有对应的 service（class late_start, user root,
# group bluetooth net_bt），但此前因为 BOARD_HAVE_BCM_FM=false 让它根本没被
# 编译、更没装进镜像，所以从来跑不起来——这才是 FM 完全不可用的第一层原因。
#
# 它的职责：通过 bcm_ldisc 驱动暴露的 sysfs 节点（install / vendor_params /
# snoop_enable / bdaddr / fw_patchfile）给 BCM4354 下发 patchram 参数、控制芯片
# 上电时序，把芯片从「蓝牙 HCI 模式」切到「UIM/FM 模式」。之后
# libfmradio.v4l2-fm 才能 open("/dev/radio0") 与芯片通信。
#
# 注意本文件原来只有一行 "type uim, domain;"（也没人给 uim 配 exec_type，
# 所以 init_daemon_domain 用不了，进程实际会掉到 init 域）。这里补齐：
#   - uim_exec 可执行文件类型（file_contexts 里已挂到 /vendor/bin/brcm-uim-sysfs）
#   - init_daemon_domain：让 init 孵化时自动从 uim_exec 切到 uim 域
#   - 最小访问集合：读 bt_vendor.conf、读写 bcm_ldisc 的 sysfs、开蓝牙串口
#
# 本机 SELinux 目前是 permissive（BoardConfig: androidboot.selinux=permissive），
# 所以这些规则眼下不会真的拦截任何操作，但作用有三：
#   1) 让 uim 真的跑在自己的域里，而不是 init 域（排查日志更清楚）；
#   2) 将来切 enforcing 时不用从零补；
#   3) 减少开机期间 permissive=1 的 avc denial 噪音（每条都要写 logd，很占 IO）。

type uim, domain;
type uim_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(uim)

# 读 /system/etc/bluetooth/bt_vendor.conf（UimUartPort / UartBaudRate /
# FwPatchFileName / LpmEnable 等参数就从这个文件来）。
allow uim system_file:file r_file_perms;

# bcm_ldisc 的 sysfs 通道：install、vendor_params、snoop_enable、bdaddr、fw_patchfile。
# uim 要读状态、写参数，所以给目录 search 和文件读写。
allow uim sysfs:dir search;
allow uim sysfs:file rw_file_perms;

# ==== 关键：芯片上电（FM，2026-11-16 真机实测）====
#
# uim 负责给 BCM4354 的 BT/FM 核上电，方式是写
#     /sys/class/rfkill/rfkill0/state        （u:object_r:sysfs_bluetooth_writable）
# 这个 rfkill 由 bluedroid_pm 驱动提供，name=bluedroid_pm，最终落到
# board-mocha.c 里的 shutdown_gpio = TEGRA_GPIO_PR1（BT_REG_ON）。
#
# 实测：PR1 为低电平（/sys/kernel/debug/gpio 里 "gpio-137 (shutdown_gpio) out lo"）
# 时，芯片 BT 核完全不上电，往 /dev/ttyTHS2 发 HCI Reset 四条 ttyTHS 全无响应；
# 把 state 写成 1 之后立刻收到
#     04 0e 04 01 03 0c 00        （HCI Reset 的 Command Complete）
# 也就是说没有这条写权限，FM（和蓝牙）永远起不来。
#
# 原来的 sysfs:file 规则覆盖不到 sysfs_bluetooth_writable 这个属性类型，
# permissive 下靠放行才偶然能跑，enforcing 会直接失败。
allow uim sysfs_bluetooth_writable:file rw_file_perms;

# 蓝牙串口：bt_vendor.conf 里 UartPort = /dev/ttyTHS2
allow uim tty_device:chr_file rw_file_perms;

# ==== 属性访问（2026-11-16，纯净镜像实测后补）====
#
# 补上 tty_device 标签、sysfs_bluetooth_writable 之后重新抓 avc，uim 只剩
# 下面两类属性读取仍被拒（permissive 下不阻塞，但 enforcing 会直接失败）：
#
#   avc: denied { read } name="u:object_r:default_prop:s0"
#       scontext=u:r:uim:s0 tcontext=u:object_r:default_prop:s0 tclass=file
#   avc: denied { read } name="u:object_r:exported_bluetooth_prop:s0"
#       scontext=u:r:uim:s0 tcontext=u:object_r:exported_bluetooth_prop:s0 tclass=file
#
# uim 在初始化时要查蓝牙相关配置（芯片型号、bdaddr 路径等），走的是通用
# 属性通道，所以会碰到没被细分类型的 default_prop；另外 bt_vendor.conf 的
# 解析过程会读 exported_bluetooth_prop（如 ro.bt.xxx）。
# 用 get_prop 宏而不是裸 allow，是为了拿到 AOSP 规定的 get_prop 权限集合。
get_prop(uim, default_prop)
get_prop(uim, exported_bluetooth_prop)

# libnetutils / socket 相关（uim 链接了 libnetutils）
allow uim self:capability { net_admin net_raw };
allow uim self:{ rawip_socket tcp_socket udp_socket } { create ioctl read write getattr setopt };
